---
import type { CollectionEntry } from "astro:content";
import { t } from "@/i18n";
import { formatDateLong } from "@/toolkit/posts/formatDate";

interface Props {
  moment: CollectionEntry<"moments">;
}

const { moment } = Astro.props;

function resolveImageSrc(image: unknown): string | undefined {
  if (typeof image === "string") {
    return image;
  }
  if (image && typeof image === "object" && "src" in image) {
    return (image as { src: string }).src;
  }
  return undefined;
}

const images =
  moment.data.images
    ?.map(resolveImageSrc)
    .filter((src): src is string => Boolean(src)) || [];
const content = (moment.body || "").trim();
---

<article class="moment">
  <header class="moment__head">
    <time datetime={moment.data.date.toISOString()}>
      {formatDateLong(moment.data.date)}
    </time>
  </header>

  {
    content && (
      <div class="moment__content">
        <div class="moment__text" set:html={content} />
      </div>
    )
  }

  {
    images.length > 0 && (
      <div class="moment__images" data-count={images.length} data-image-zoom-gallery>
        {images.map((src, index) => (
          <div class="moment__image-wrap">
            <image-zoom>
              <img
                src={src}
                alt={t("moments.imageAlt", { index: index + 1 })}
                loading="lazy"
                decoding="async"
                class="moment__image"
              />
            </image-zoom>
          </div>
        ))}
      </div>
    )
  }
</article>

<style>
  .moment {
    position: relative;
    padding: 0 0 2rem 1.75rem;
  }

  .moment::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--primary-color, #7c3b52);
  }

  .moment:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 2px;
    top: 1.15rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--hairline, rgb(0 0 0 / 8%));
  }

  .moment__head {
    margin: 0 0 0.55rem;
  }

  .moment__head time {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-color-subtle, #8a857c);
  }

  .moment__text {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.96rem;
    line-height: 1.85;
    color: var(--text-color, #23211d);
    word-break: break-word;
    white-space: pre-wrap;
  }

  .moment__text :global(p) {
    margin: 0 0 0.5rem;
  }

  .moment__text :global(p:last-child) {
    margin-bottom: 0;
  }

  .moment__text :global(a) {
    color: var(--link-color, var(--primary-color, #7c3b52));
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .moment__text :global(img) {
    max-width: 100%;
    border-radius: var(--radius-sm, 4px);
  }

  .moment__images {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.9rem;
    max-width: 100%;
  }

  .moment__images[data-count="1"] {
    grid-template-columns: 1fr;
    max-width: 26rem;
  }

  .moment__images[data-count="2"] {
    grid-template-columns: repeat(2, 1fr);
    max-width: 34rem;
  }

  .moment__images[data-count="3"] {
    grid-template-columns: repeat(3, 1fr);
    max-width: 40rem;
  }

  .moment__images[data-count="4"] {
    grid-template-columns: repeat(2, 1fr);
    max-width: 34rem;
  }

  .moment__images[data-count="5"],
  .moment__images[data-count="6"],
  .moment__images[data-count="7"],
  .moment__images[data-count="8"],
  .moment__images[data-count="9"] {
    grid-template-columns: repeat(3, 1fr);
    max-width: 40rem;
  }

  .moment__image-wrap {
    overflow: hidden;
    border-radius: var(--radius-sm, 4px);
    background: var(--surface-subtle, #f4f2ee);
    line-height: 0;
  }

  .moment__image-wrap :global(image-zoom) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    line-height: 0;
  }

  .moment__image {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 22rem;
    object-fit: cover;
    transition: opacity 0.25s ease;
  }

  .moment__image-wrap:hover .moment__image {
    opacity: 0.92;
  }

  @media (max-width: 480px) {
    .moment {
      padding-left: 1.25rem;
    }

    .moment__images[data-count="3"],
    .moment__images[data-count="5"],
    .moment__images[data-count="6"],
    .moment__images[data-count="7"],
    .moment__images[data-count="8"],
    .moment__images[data-count="9"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
