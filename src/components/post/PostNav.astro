---
/**
 * 上一篇 / 下一篇（编辑式纯文字，不使用随机配图）
 */
import { currentLocale, getT } from "@/i18n";

interface NavPost {
  title: string;
  slug: string;
  category?: string;
}

interface Props {
  prevPost?: NavPost;
  nextPost?: NavPost;
  /** 兼容旧调用方，已不生效 */
  nextGradientCover?: boolean;
}

const { prevPost, nextPost } = Astro.props;
const t = getT(currentLocale);
---

<div class="post-nav">
  <div class="item left">
    {
      prevPost && (
        <a href={`/posts/${prevPost.slug}/`} itemprop="url" rel="prev" title={prevPost.title}>
          <span class="type">{t("post.previousPost")}</span>
          {prevPost.category && <span class="category">{prevPost.category}</span>}
          <span class="post-nav-title">{prevPost.title}</span>
        </a>
      )
    }
  </div>

  <div class="item right">
    {
      nextPost && (
        <a href={`/posts/${nextPost.slug}/`} itemprop="url" rel="next" title={nextPost.title}>
          <span class="type">{t("post.nextPost")}</span>
          {nextPost.category && <span class="category">{nextPost.category}</span>}
          <span class="post-nav-title">{nextPost.title}</span>
        </a>
      )
    }
  </div>
</div>

<style>
  .post-nav {
    max-width: var(--reading-width, 43rem);
  }

  .post-nav .category {
    display: inline-block;
    margin-bottom: 0.2rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--primary-color, #7c3b52);
  }
</style>
