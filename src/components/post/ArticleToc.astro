---
/**
 * 文章目录：移动端折叠在正文上方，桌面端固定在右侧。
 * 当前章节高亮由组件内的滚动驱动逻辑完成（无第三方依赖）。
 */
import type { TocItem } from "@/components/sidebar/SidebarTypes";

interface Props {
  toc: TocItem[];
  /** desktop 固定在右栏，mobile 折叠在正文上方 */
  variant?: "desktop" | "mobile";
}

const { toc, variant = "desktop" } = Astro.props;
// 只保留正文层级（h2/h3），避免目录过长
const items = toc.filter((item) => item.level >= 2 && item.level <= 3);
---

{
  items.length > 1 && (
    <div class:list={["toc", `toc--${variant}`]} data-toc>
      {variant === "mobile" ? (
        <details class="toc__details">
          <summary class="toc__summary">本文目录</summary>
          <ol class="toc__list">
            {items.map((item) => (
              <li class:list={["toc__item", `toc__item--h${Math.min(item.level, 3)}`]}>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </details>
      ) : (
        <nav class="toc__nav" aria-label="本文目录">
          <p class="toc__title">目录</p>
          <ol class="toc__list">
            {items.map((item) => (
              <li class:list={["toc__item", `toc__item--h${Math.min(item.level, 3)}`]}>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  )
}

<script>
  /**
   * 滚动驱动的目录高亮：以“阅读线”（导航下方约 120px）判定当前章节，
   * 长章节、反向滚动与页底都能正确命中；桌面端附带随动指示条。
   */
  const initToc = () => {
    const roots = [...document.querySelectorAll<HTMLElement>("[data-toc]")];
    if (roots.length === 0) {
      return;
    }

    const entries = roots.map((root) => {
      const links = [...root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((link) => ({
        link,
        targetId: decodeURIComponent(link.hash.slice(1)),
      }));
      const nav = root.querySelector<HTMLElement>(".toc__nav");
      let indicator: HTMLElement | null = null;
      if (nav) {
        indicator = document.createElement("span");
        indicator.className = "toc__indicator";
        indicator.setAttribute("aria-hidden", "true");
        nav.append(indicator);
      }
      return { links, nav, indicator };
    });

    const ids = [...new Set(entries.flatMap((entry) => entry.links.map(({ targetId }) => targetId)))];
    const headings = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null)
      .toSorted((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

    if (headings.length === 0) {
      return;
    }

    let activeId = "";
    const setActive = (id: string) => {
      if (id === activeId) {
        return;
      }
      activeId = id;

      for (const { links, nav, indicator } of entries) {
        let activeLink: HTMLAnchorElement | null = null;
        for (const { link, targetId } of links) {
          const isActive = targetId === id;
          link.classList.toggle("is-active", isActive);
          if (isActive) {
            activeLink = link;
          }
        }

        if (indicator && nav) {
          if (activeLink) {
            const navRect = nav.getBoundingClientRect();
            const linkRect = activeLink.getBoundingClientRect();
            indicator.style.height = `${linkRect.height}px`;
            indicator.style.transform = `translateY(${linkRect.top - navRect.top + nav.scrollTop}px)`;
            indicator.classList.add("is-visible");
          } else {
            indicator.classList.remove("is-visible");
          }
        }
      }
    };

    const update = () => {
      const probe = window.scrollY + 120;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top + window.scrollY <= probe) {
          current = heading;
        } else {
          break;
        }
      }
      // 页底时最后一个章节可能永远到不了阅读线，直接命中末章
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        current = headings[headings.length - 1];
      }
      setActive(current.id);
    };

    let frame = 0;
    const onScroll = () => {
      if (frame) {
        return;
      }
      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initToc, { once: true });
  } else {
    initToc();
  }
</script>

<style>
  .toc--mobile {
    display: block;
    margin: 0 0 2rem;
  }

  .toc--desktop {
    display: none;
  }

  .toc__details {
    border-top: var(--hairline);
    border-bottom: var(--hairline);
    padding: 0.85rem 0;
  }

  .toc__summary {
    cursor: pointer;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-color-muted, #6b675f);
    list-style: none;
  }

  .toc__summary::-webkit-details-marker {
    display: none;
  }

  .toc__summary::after {
    content: "＋";
    float: right;
    color: var(--text-color-subtle, #8a857c);
  }

  .toc__details[open] .toc__summary::after {
    content: "－";
  }

  .toc__nav {
    position: sticky;
    top: calc(var(--nav-height, 4rem) + 2rem);
    max-height: calc(100vh - var(--nav-height, 4rem) - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-left: 1.15rem;
    border-left: var(--hairline);
  }

  /* 随阅读进度移动的指示条 */
  .toc__indicator {
    position: absolute;
    top: 0;
    left: -1px;
    width: 2px;
    border-radius: 1px;
    background: var(--primary-color, #7c3b52);
    opacity: 0;
    transition:
      transform var(--dur-2, 0.2s) var(--ease-out, ease),
      height var(--dur-2, 0.2s) var(--ease-out, ease),
      opacity var(--dur-2, 0.2s) var(--ease-out, ease);
  }

  .toc__indicator.is-visible {
    opacity: 1;
  }

  .toc__title {
    margin: 0 0 0.9rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-color-subtle, #8a857c);
  }

  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .toc__item a {
    display: block;
    padding: 0.22rem 0;
    border: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .toc__item--h3 a {
    padding-left: 0.85rem;
    font-size: 0.76rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .toc__item a:hover,
  .toc__item a.is-active {
    color: var(--primary-color, #7c3b52);
  }

  .toc__item a.is-active {
    font-weight: 500;
  }

  @media (min-width: 1100px) {
    .toc--mobile {
      display: none;
    }

    .toc--desktop {
      display: block;
    }
  }
</style>
