---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  author: string;
  description: string;
  avatar?: ImageMetadata;
  stats: { posts: number; categories: number; tags: number; since: number };
  latest?: { title: string; href: string; date: Date };
  social?: { label: string; href: string; icon?: string }[];
}

const { author, description, avatar, stats, latest, social = [] } = Astro.props;
const latestDate = latest?.date.toISOString().slice(0, 10);
---

<section class="profile" aria-labelledby="profile-title">
  <div class="profile__identity">
    {avatar && (
      <Image
        class="profile__avatar"
        src={avatar}
        alt=""
        width={96}
        height={96}
        widths={[80, 160, 240]}
        sizes="(max-width: 480px) 3.5rem, 5rem"
        loading="eager"
        decoding="async"
      />
    )}
    <div>
      <p class="profile__since">{stats.since} 年开始写博客</p>
      <h1 id="profile-title">{author}</h1>
    </div>
  </div>
  <p class="profile__bio">{description}</p>
  <div class="profile__links">
    <a class="action-link action-link--primary" href="/about/">
      关于我 <span class="action-link__arrow i-ri-arrow-right-line" aria-hidden="true"></span>
    </a>
    {social.map(({ label, href, icon }) => (
      <a class="action-link" href={href} rel="me">
        {icon && <span class={icon} aria-hidden="true"></span>}
        {label}
      </a>
    ))}
  </div>
  <div class="profile__index" aria-label="笔记索引">
    <a href="/archives/"><strong>{stats.posts}</strong> 篇笔记</a>
    <a href="/categories/"><strong>{stats.categories}</strong> 个分类</a>
    <a href="/tags/"><strong>{stats.tags}</strong> 个标签</a>
  </div>
  {latest && (
    <a class="profile__latest action-link" href={latest.href}>
      <span class="profile__latest-copy">
        <span class="profile__latest-date">最近更新 <time datetime={latestDate}>{latestDate}</time></span>
        <strong>{latest.title}</strong>
      </span>
      <span class="action-link__arrow i-ri-arrow-right-line" aria-hidden="true"></span>
    </a>
  )}
</section>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-sm);
    padding: clamp(1.125rem, 2.8vw, 2rem);
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-tinted);
  }

  .profile__identity {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.15rem);
  }

  .profile__avatar {
    width: clamp(3.5rem, 7vw, 5rem);
    height: auto;
    aspect-ratio: 1;
    flex: none;
    object-fit: cover;
    border: var(--hairline);
    border-radius: 50%;
    background: var(--surface-raised);
  }

  .profile h1 {
    font-size: clamp(1.65rem, 1.22rem + 1.35vw, 2.45rem);
    text-wrap: initial;
  }

  .profile__since,
  .profile__index,
  .profile__latest {
    color: var(--text-color-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .profile__since {
    margin-bottom: var(--space-3xs);
  }

  .profile__bio {
    max-width: 31em;
    line-height: var(--leading-normal);
    font-size: var(--text-sm);
  }

  .profile__links,
  .profile__index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .profile__links {
    gap: var(--space-2xs);
  }

  .profile__index {
    margin-top: auto;
    padding-top: var(--space-xs);
    border-top: var(--hairline);
  }

  .profile__index a {
    color: inherit;
    text-decoration: none;
  }

  .profile__index a:hover,
  .profile__index a:focus-visible {
    color: var(--link-color);
    text-decoration: underline;
  }

  .profile__index strong {
    color: var(--text-color);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .profile .profile__latest {
    justify-content: space-between;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--surface-raised);
  }

  .profile__latest-copy {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .profile__latest-date {
    font-size: var(--text-2xs);
    color: var(--text-color-muted);
    font-variant-numeric: tabular-nums;
  }

  .profile__latest strong {
    color: var(--text-color);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
</style>
