---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import QuoteLine from "@/components/home/QuoteLine.astro";

interface Props {
  author: string;
  description: string;
  avatar?: ImageMetadata;
  stats: { posts: number; categories: number; tags: number; since: number };
  social?: { label: string; href: string; icon?: string }[];
}

const { author, description, avatar, stats, social = [] } = Astro.props;
---

<section class="profile" aria-labelledby="profile-title">
  <div class="profile__identity">
    {avatar && (
      <Image
        class="profile__avatar"
        src={avatar}
        alt={author}
        width={96}
        height={96}
        widths={[80, 160, 240]}
        sizes="(max-width: 480px) 3.5rem, 5rem"
        loading="eager"
        decoding="async"
      />
    )}
    <div>
      <p class="profile__since">{stats.since} 年开始写博客</p>
      <h1 id="profile-title">{author}</h1>
    </div>
  </div>
  <p class="profile__bio">{description}</p>
  <QuoteLine />
  <div class="profile__links">
    <a class="action-link action-link--primary" href="/about/">
      关于我 <span class="action-link__arrow i-ri-arrow-right-line" aria-hidden="true"></span>
    </a>
    {social.map(({ label, href, icon }) => (
      <a class="action-link" href={href} rel="me">
        {icon && <span class={icon} aria-hidden="true"></span>}
        {label}
      </a>
    ))}
  </div>
  <div class="profile__index" aria-label="笔记索引">
    <a href="/archives/"><strong>{stats.posts}</strong> 篇笔记</a>
    <a href="/categories/"><strong>{stats.categories}</strong> 个分类</a>
    <a href="/tags/"><strong>{stats.tags}</strong> 个标签</a>
  </div>
</section>

<style>
  .profile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-sm);
    padding: clamp(1.125rem, 2.8vw, 2rem);
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-tinted);
  }

  /* 极光辉光：三团品牌色缓慢漂移，营造 DeepMind 式的冷调氛围。
     用 background-position 而非 transform 漂移，避免产生可滚动溢出。 */
  .profile::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38% 46% at 18% 22%, var(--aurora-blue), transparent 70%),
      radial-gradient(34% 42% at 82% 18%, var(--aurora-violet), transparent 70%),
      radial-gradient(42% 50% at 62% 88%, var(--aurora-teal), transparent 72%);
    background-size:
      160% 160%,
      150% 150%,
      170% 170%;
    background-repeat: no-repeat;
    animation: aurora-drift 28s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes aurora-drift {
    from {
      background-position:
        0% 0%,
        100% 0%,
        50% 100%;
    }

    to {
      background-position:
        100% 100%,
        0% 100%,
        20% 0%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile::before {
      animation: none;
    }

    .profile__avatar {
      transition: none;
    }

    .profile__avatar:hover {
      transform: none;
    }
  }

  .profile__identity {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.15rem);
  }

  .profile__avatar {
    width: clamp(3.5rem, 7vw, 5rem);
    height: auto;
    aspect-ratio: 1;
    flex: none;
    object-fit: cover;
    border: var(--hairline);
    border-radius: 50%;
    background: var(--surface-raised);
    transition: transform var(--dur-spring, 0.3s) var(--ease-spring, ease-out);
  }

  .profile__avatar:hover {
    transform: rotate(-3deg) scale(1.05);
  }

  .profile h1 {
    font-size: clamp(1.65rem, 1.22rem + 1.35vw, 2.45rem);
    text-wrap: initial;
  }

  .profile__since,
  .profile__index {
    color: var(--text-color-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .profile__since {
    margin-bottom: var(--space-3xs);
  }

  .profile__bio {
    max-width: 31em;
    line-height: var(--leading-normal);
    font-size: var(--text-sm);
  }

  .profile__links,
  .profile__index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .profile__links {
    gap: var(--space-2xs);
  }

  .profile__index {
    margin-top: auto;
    padding-top: var(--space-xs);
    border-top: var(--hairline);
  }

  .profile__index a {
    color: inherit;
    text-decoration: none;
  }

  .profile__index a:hover,
  .profile__index a:focus-visible {
    color: var(--link-color);
    text-decoration: underline;
  }

  .profile__index strong {
    color: var(--text-color);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }
</style>
