---
/**
 * 全局 SEO 头部组件：canonical、Open Graph、Twitter Card、theme-color。
 * 在 Layout.astro 的 <head> 中、页面自定义 head fragment 之前渲染。
 * meta description 仍由各页面通过 slot="head" 提供，避免重复标签。
 */
import type { ImageMetadata } from "astro";
import themeConfig from "@/theme.config.ts";
import { currentLocale } from "@/i18n";

interface Props {
  /** 页面标题（og:title / twitter:title） */
  title?: string;
  /** 页面描述（og:description / twitter:description），默认回退到站点简介 */
  description?: string;
  /** 社交分享图（og:image），未提供时回退到站点头像 */
  image?: ImageMetadata | string;
  /** OG 类型：文章页传 article，其余页面默认 website */
  type?: "website" | "article";
  /** 文章页可传入发布/更新时间（ISO 字符串） */
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  tags,
} = Astro.props;

const siteName = themeConfig.siteName;
const site = Astro.site ?? new URL("https://forrestgump618.github.io");
const locale = currentLocale ?? themeConfig.locale ?? "zh-CN";

const canonical = new URL(Astro.url.pathname, site).href;
const ogTitle = title ? `${title} - ${siteName}` : siteName;
const ogDescription = description || themeConfig.sidebar?.description || siteName;

const ogImage = (() => {
  if (image) {
    const src = typeof image === "string" ? image : image.src;
    return /^https?:\/\//.test(src) ? src : new URL(src, site).href;
  }
  return undefined;
})();

const twitterCard = ogImage ? "summary_large_image" : "summary";
---

<link rel="canonical" href={canonical} />

<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fefefe" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1d1d26" />

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale} />
{ogImage && <meta property="og:image" content={ogImage} />}
{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === "article" && tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
