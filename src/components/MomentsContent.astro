---
import type { CollectionEntry } from "astro:content";
import MomentCard from "./MomentCard.astro";
import { t } from "@/i18n";

interface Props {
  moments: CollectionEntry<"moments">[];
}

const { moments } = Astro.props;
---

<div class="moments">
  {
    moments.length > 0 ? (
      moments.map((moment) => <MomentCard moment={moment} />)
    ) : (
      <p class="moments__empty">{t("moments.noContent")}</p>
    )
  }
</div>

<style>
  .moments {
    max-width: 44rem;
    padding-top: 0.25rem;
  }

  .moments__empty {
    margin: 0;
    padding: 3rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.9rem;
    color: var(--text-color-subtle, #8a857c);
    text-align: center;
  }
</style>
