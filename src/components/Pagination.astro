---
import { getT } from "@/i18n";
import { buildPaginationItems } from "@/toolkit/posts/buildPaginationItems";

interface Props {
  currentPage: number;
  lastPage: number;
  /** 第一页链接，默认 '/' */
  firstPageHref?: string;
  /** 其他页前缀，默认 '/page'，最终会输出 `${routePrefix}/${n}/` */
  routePrefix?: string;
  ariaLabel?: string;
}

const {
  currentPage,
  lastPage,
  firstPageHref = "/",
  routePrefix = "/page",
  ariaLabel = "Pagination",
} = Astro.props;

const clampInt = (n: number) => Math.max(1, Math.floor(n || 1));
const safeCurrent = clampInt(currentPage);
const safeLast = clampInt(lastPage);

const getHref = (n: number) => {
  const pageNum = clampInt(n);
  if (pageNum <= 1) return firstPageHref;
  return `${routePrefix}/${pageNum}/`;
};

const prevHref = safeCurrent > 1 ? getHref(safeCurrent - 1) : undefined;
const nextHref = safeCurrent < safeLast ? getHref(safeCurrent + 1) : undefined;

const items = buildPaginationItems(safeCurrent, safeLast);
const t = getT();
---

{
  safeLast > 1 && (
    <nav class="pagination" aria-label={ariaLabel}>
      <div class="inner">
        {prevHref ? (
          <a class="prev" href={prevHref} rel="prev">
            {t("pagination.prev")}
          </a>
        ) : null}

        {items.map((it) =>
          it === "…" ? (
            <span class="space" aria-hidden="true">
              …
            </span>
          ) : it === safeCurrent ? (
            <span class="page-number current" aria-current="page">
              {it}
            </span>
          ) : (
            <a class="page-number" href={getHref(it)}>
              {it}
            </a>
          ),
        )}

        {nextHref ? (
          <a class="next" href={nextHref} rel="next">
            {t("pagination.next")}
          </a>
        ) : null}
      </div>
    </nav>
  )
}

<style>
  .pagination {
    width: 100%;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .pagination .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
  }

  .pagination .prev,
  .pagination .next,
  .pagination .page-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.15rem;
    height: 2.15rem;
    padding: 0 0.65rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .pagination .prev,
  .pagination .next {
    letter-spacing: 0.02em;
    border-color: var(--line-color, rgb(0 0 0 / 12%));
  }

  .pagination .prev {
    margin-right: 0.35rem;
  }

  .pagination .next {
    margin-left: 0.35rem;
  }

  .pagination .prev:hover,
  .pagination .next:hover,
  .pagination .page-number:hover {
    color: var(--text-color, #23211d);
    background: var(--surface-subtle, #f4f2ee);
    border-color: var(--hairline, rgb(0 0 0 / 8%));
  }

  .pagination .page-number.current {
    background: var(--text-color, #23211d);
    border-color: var(--text-color, #23211d);
    color: var(--surface-page, #fdfcfa);
    font-weight: 600;
  }

  .pagination .page-number.current:hover {
    background: var(--text-color, #23211d);
    color: var(--surface-page, #fdfcfa);
  }

  .pagination .space {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 2.15rem;
    color: var(--text-color-subtle, #8a857c);
    font-size: 0.8rem;
  }

  @media (max-width: 480px) {
    .pagination .prev,
    .pagination .next {
      padding: 0 0.5rem;
    }

    .pagination .prev {
      margin-right: 0.15rem;
    }

    .pagination .next {
      margin-left: 0.15rem;
    }
  }
</style>
