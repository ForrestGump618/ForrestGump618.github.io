---
import { QUOTES } from "@/toolkit/ui/quotes";

const quote = QUOTES[0];
---

<p class="quote" aria-live="polite">
  <span class="quote__text">{quote.text}</span>
  <span class="quote__source">—— {quote.source}</span>
  <button type="button" class="quote__next" aria-label="换一句" title="换一句">
    <span class="i-ri-refresh-line" aria-hidden="true"></span>
  </button>
</p>

<script>
  import { QUOTES, pickNextQuoteIndex } from "@/toolkit/ui/quotes";

  // 格言是首屏 LCP 文本：保持纯 SSR 首绘，交互由本脚本渐进接管，
  // 不做 island 水合，避免水合重绘把 LCP 推迟到主线程空闲之后。
  const root = document.querySelector(".quote");
  const button = root?.querySelector<HTMLButtonElement>(".quote__next");
  const text = root?.querySelector(".quote__text");
  const source = root?.querySelector(".quote__source");
  if (root && button && text && source) {
    let index = 0;
    let fading = false;
    button.dataset.hydrated = "true";
    button.addEventListener("click", () => {
      if (fading) {
        return;
      }

      const target = pickNextQuoteIndex(index, Math.random);
      const apply = () => {
        index = target;
        text.textContent = QUOTES[index].text;
        source.textContent = `—— ${QUOTES[index].source}`;
      };
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        apply();
        return;
      }

      fading = true;
      root.classList.add("is-fading");
      window.setTimeout(() => {
        apply();
        root.classList.remove("is-fading");
        fading = false;
      }, 180);
    });
  }
</script>

<style>
  .quote {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    margin: 0;
    font-family: var(--font-kai);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--text-color-muted);
    transition:
      opacity 180ms var(--ease-out),
      translate 180ms var(--ease-out);
  }

  .quote.is-fading {
    opacity: 0;
    translate: 0 4px;
  }

  .quote__source {
    font-size: var(--text-2xs);
    color: var(--text-color-subtle);
  }

  .quote__next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-color-subtle);
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      rotate var(--dur-3) var(--ease-out);
  }

  .quote__next:hover,
  .quote__next:focus-visible {
    color: var(--primary-color);
    background: color-mix(in oklab, var(--primary-color) 10%, transparent);
    rotate: 90deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .quote,
    .quote__next {
      transition: none;
    }
  }
</style>