---
/**
 * 首页主体：精选文章（整卡可点）→ 最新笔记（紧凑行）→ 漫览（图表画廊）→ 专题分类。
 * 首页是聚合落地页：精选文章不重复出现在最新列表，分页统一放在归档。
 * 图片只出现在「精选」与「漫览」，且均来自内容本身。
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import CoverMedia from "@/components/media/CoverMedia.astro";
import { resolvePostCover } from "@/toolkit/covers";
import { formatDateLong, formatDateMachine } from "@/toolkit/posts/formatDate";
import { getReadingStats } from "@/toolkit/posts/readingStats";
import { toPostHref } from "@/toolkit/posts/url";

interface HomeCategory {
  name: string;
  href: string;
  count: number;
  recent: { title: string; href: string }[];
}

interface Props {
  posts: CollectionEntry<"posts">[];
  /** 全量文章池：用于挑选漫览画廊（不受最新列表条数限制） */
  pool?: CollectionEntry<"posts">[];
  featuredPost?: CollectionEntry<"posts">;
  categories?: HomeCategory[];
}

const { posts, pool = posts, featuredPost, categories = [] } = Astro.props;

const excerptOf = (post: CollectionEntry<"posts">, limit = 96) => {
  const raw = (post.data.description || post.body || "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/<[^>]+>/g, "")
    .replace(/[#*`_>|-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  return raw.length > limit ? `${raw.slice(0, limit).trimEnd()}…` : raw;
};

const prepare = (post: CollectionEntry<"posts">) => ({
  post,
  cover: resolvePostCover({
    id: post.id,
    title: post.data.title,
    categories: post.data.categories,
    tags: post.data.tags,
    cover: post.data.cover,
    description: post.data.description,
  }),
  stats: getReadingStats(post.body ?? ""),
  href: toPostHref(post.id),
  excerpt: excerptOf(post),
  dateMachine: formatDateMachine(post.data.date),
  dateLong: formatDateLong(post.data.date),
  category: post.data.categories?.[0] ?? "笔记",
});

const featured = featuredPost ? prepare(featuredPost) : null;
const latest = posts.map(prepare);
const galleryPosts = pool
  .filter((post) => post.id !== featuredPost?.id)
  .map(prepare)
  .filter((item) => item.cover.band && (item.cover.Image || item.cover.src))
  .slice(0, 3);
const hasFeaturedMedia = featured ? featured.cover.kind !== "none" : false;

// 单篇分类合并为一行快捷入口，避免整卡只装一篇文章
const topicCategories = categories.filter((category) => category.count > 1);
const singleCategories = categories.filter((category) => category.count === 1);
---

<div class="home-opening reveal" style="--reveal-i:0">
  <slot name="profile" />
  {featured && (
    <section class="home-featured" aria-labelledby="featured-heading">
      <h2 class="sr-only" id="featured-heading">
        {featuredPost?.data.sticky ? "置顶文章" : "精选文章"}
      </h2>
      <a
        class:list={["featured", { "featured--text": !hasFeaturedMedia }]}
        href={featured.href}
        aria-label={`阅读文章：${featured.post.data.title}`}
      >
        {hasFeaturedMedia && (
          <div class="featured__media">
            <CoverMedia
              cover={featured.cover}
              title={featured.post.data.title}
              variant="wide"
              eager
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 831px) 90vw, (min-width: 1090px) min(29vw, 21rem), 56vw"
              showCaption={false}
            />
          </div>
        )}
        <div class="featured__body">
          <p class="featured__eyebrow">
            <span class="featured__flag">{featuredPost?.data.sticky ? "置顶" : "精选"}</span>
            {featured.category}
          </p>
          <h3 class="featured__title">{featured.post.data.title}</h3>
          {featured.excerpt && <p class="featured__excerpt">{featured.excerpt}</p>}
          <p class="featured__meta">
            <time datetime={featured.post.data.date.toISOString()}>{featured.dateLong}</time>
            {featured.stats.readTime > 0 && (
              <>
                <span class="featured__dot" aria-hidden="true">·</span>
                约 {featured.stats.readTime} 分钟
              </>
            )}
          </p>
          <span class="featured__cta action-link action-link--primary">
            阅读文章 <span class="action-link__arrow i-ri-arrow-right-line" aria-hidden="true"></span>
          </span>
        </div>
      </a>
    </section>
  )}
</div>

<section class="home-list reveal" style="--reveal-i:1" aria-labelledby="latest-heading">
  <div class="section-head">
    <div>
      <h2 class="section-head__title" id="latest-heading">最新笔记</h2>
    </div>
    <a class="section-head__more" href="/archives/">全部笔记<span aria-hidden="true"> →</span></a>
  </div>

  {latest.length === 0 ? (
    <p class="home-empty">
      这里还没有文章。<a href="/archives/">去归档看看</a>
    </p>
  ) : (
    <ol class="post-list">
      {latest.map((item) => (
        <li class="post-row">
          <a class="post-row__link" href={item.href}>
            <span class="post-row__main">
              <span class="post-row__cat">{item.category}</span>
              <span class="post-row__title" title={item.post.data.title}>{item.post.data.title}</span>
            </span>
            <span class="post-row__meta">
              {item.stats.readTime > 0 && (
                <span class="post-row__read">{item.stats.readTime} 分钟</span>
              )}
              <time class="post-row__date" datetime={item.post.data.date.toISOString()}>{item.dateMachine}</time>
            </span>
          </a>
        </li>
      ))}
    </ol>
  )}
</section>

{galleryPosts.length > 0 && (
  <section class="home-gallery reveal" style="--reveal-i:2" aria-labelledby="gallery-heading">
    <div class="section-head">
      <div>
        <h2 class="section-head__title" id="gallery-heading">漫览</h2>
        <p class="section-head__sub">科研图表与解剖图解，点击图片可放大浏览。</p>
      </div>
    </div>
    <div class="gallery-grid" data-image-zoom-gallery>
      {galleryPosts.map((item) => (
        <figure class="gallery-card">
          <div class="gallery-card__frame">
            <image-zoom class="gallery-card__zoom" data-fill>
              {item.cover.Image ? (
                <Image
                  src={item.cover.Image}
                  alt={item.cover.alt}
                  widths={[320, 480, 640, 960]}
                  sizes="(max-width: 700px) 92vw, 24rem"
                  loading="lazy"
                  decoding="async"
                  class="gallery-card__img"
                />
              ) : (
                <img
                  src={item.cover.src}
                  alt={item.cover.alt}
                  loading="lazy"
                  decoding="async"
                  class="gallery-card__img"
                />
              )}
            </image-zoom>
          </div>
          <figcaption class="gallery-card__body">
            <span class="gallery-card__title">{item.post.data.title}</span>
            <a class="gallery-card__enter" href={item.href}>
              进入原文 <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
            </a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{categories.length > 0 && (
  <section class="home-topics reveal" style="--reveal-i:3" aria-labelledby="topics-heading">
    <div class="section-head">
      <div>
        <h2 class="section-head__title" id="topics-heading">专题分类</h2>
      </div>
    </div>
    <div class="topic-grid">
      {topicCategories.map((category) => (
        <article class="topic-card">
          <a class="topic-card__head" href={category.href}>
            <span class="topic-card__name">{category.name}</span>
            <span class="topic-card__count">{category.count} 篇</span>
          </a>
          {category.recent.length > 0 && (
            <ul class="topic-card__list">
              {category.recent.slice(0, 3).map((entry) => (
                <li>
                  <a href={entry.href} title={entry.title}>{entry.title}</a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
    {singleCategories.length > 0 && (
      <div class="topic-singles">
        <span class="topic-singles__label">单篇专题</span>
        <div class="topic-singles__chips">
          {singleCategories.map((category) => (
            <a class="topic-chip" href={category.recent[0]?.href ?? category.href}>
              {category.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
)}

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .section-head__title {
    margin: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text-color, #23211d);
  }

  .section-head__sub {
    margin: 0.4rem 0 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .section-head__more {
    flex-shrink: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }

  .section-head__more:hover {
    color: var(--primary-color, #7c3b52);
  }

  .home-opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--rhythm-block);
  }

  .home-featured,
  .featured {
    min-width: 0;
    height: 100%;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .featured--text {
    grid-template-rows: 1fr;
  }

  .featured__media {
    overflow: hidden;
    padding: var(--space-xs) var(--space-xs) 0;
  }

  .featured__media :global(.cover-media__frame) {
    aspect-ratio: 2.55;
    padding: var(--space-2xs);
  }

  .featured__media :global(.cover-media__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-sm) clamp(1.125rem, 2.4vw, 1.75rem) var(--space-md);
  }

  .featured__cta {
    margin-top: var(--space-sm);
    pointer-events: none;
  }

  .featured:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured:focus-visible .featured__media :global(.cover-media__img) {
      transform: scale(1.035);
    }

    @media (hover: hover) and (pointer: fine) {
      .featured:hover {
        border-color: color-mix(in oklab, var(--primary-color, #7c3b52) 45%, var(--border-color));
        box-shadow: var(--shadow-md);
      }

      .featured:hover .featured__media :global(.cover-media__img) {
        transform: scale(1.035);
      }

      .featured:hover .featured__cta {
        border-color: var(--link-hover-color);
        background: var(--link-hover-color);
      }

      .featured:hover .action-link__arrow {
        translate: 3px 0;
      }
    }

    .featured:active .featured__media :global(.cover-media__img) {
      transform: scale(0.985);
    }
  }

  @container (min-width: 47rem) {
    .home-opening {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }

  @container (min-width: 62rem) {
    .featured {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr;
    }

    .featured__media {
      display: flex;
      align-items: stretch;
      padding: var(--space-xs) 0 var(--space-xs) var(--space-xs);
    }

    .featured__media :global(.cover-media) {
      display: flex;
      align-items: center;
      width: 100%;
      background: var(--surface-subtle);
    }

    .featured__media :global(.cover-media__frame) {
      background: transparent;
      border: 0;
      aspect-ratio: 1.2;
    }

    .featured--text {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .featured__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-color-muted, #6b675f);
  }

  .featured__flag {
    padding: 0.14rem 0.5rem;
    border: 1px solid color-mix(in oklab, var(--primary-color, #7c3b52) 40%, transparent);
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--primary-color, #7c3b52);
  }

  .featured__title {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: clamp(1.35rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-color, #23211d);
  }

  .featured--text .featured__title {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
  }

  .featured__excerpt {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--text-color-muted, #55524c);
  }

  .featured__meta {
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.78rem;
    color: var(--text-color-subtle, #8a857c);
    font-variant-numeric: tabular-nums;
  }

  .featured__dot {
    margin: 0 0.45rem;
  }

  /* ---------- 最新笔记：紧凑行 ---------- */
  .home-list {
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .post-row {
    border-bottom: var(--hairline);
  }

  .post-row__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.25rem;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .post-row__link:is(:hover, :focus-visible, :active) {
    background: color-mix(in oklab, var(--surface-subtle, #f4f2ee) 55%, transparent);
  }

  .post-row__main {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    min-width: 0;
  }

  .post-row__cat {
    flex: none;
    padding: 0.12rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--surface-tinted);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--primary-color, #7c3b52);
    white-space: nowrap;
  }

  .post-row__title {
    min-width: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-color, #23211d);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }

  .post-row__link:is(:hover, :focus-visible) .post-row__title {
    color: var(--primary-color, #7c3b52);
  }

  .post-row__meta {
    display: flex;
    flex: none;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.74rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .post-row__read {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-row__date {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .home-empty {
    padding: 2.5rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    color: var(--text-color-subtle, #8a857c);
  }

  .home-empty a {
    color: var(--primary-color, #7c3b52);
  }

  /* ---------- 漫览：图表画廊 ---------- */
  .home-gallery {
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .gallery-card {
    margin: 0;
    min-width: 0;
  }

  /* 论文图表多为白底：统一浅色纸面承接，暗色模式下也保持浅色 */
  .gallery-card__frame {
    aspect-ratio: 4 / 3;
    padding: clamp(0.6rem, 1.6vw, 1rem);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: #fbfaf7;
    overflow: hidden;
  }

  .gallery-card__zoom {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .gallery-card__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .gallery-card__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem;
    padding-top: 0.8rem;
  }

  .gallery-card__title {
    min-width: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-color, #23211d);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gallery-card__enter {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .gallery-card__enter:hover,
  .gallery-card__enter:focus-visible {
    color: var(--primary-color, #7c3b52);
  }

  /* ---------- 专题 ---------- */
  .home-topics {
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: var(--hairline);
  }

  .topic-card {
    padding: 1.1rem 0.25rem;
    border-bottom: var(--hairline);
  }

  .topic-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .topic-card__name {
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
    transition: color var(--dur-2) var(--ease-out);
  }

  .topic-card__head:hover .topic-card__name,
  .topic-card__head:focus-visible .topic-card__name {
    color: var(--primary-color, #7c3b52);
  }

  .topic-card__count {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-color-subtle, #8a857c);
  }

  .topic-card__list {
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .topic-card__list a {
    display: block;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }

  .topic-card__list a:hover,
  .topic-card__list a:focus-visible {
    color: var(--primary-color, #7c3b52);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topic-singles {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 1rem 0.25rem 0;
  }

  .topic-singles__label {
    flex: none;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-color-subtle, #8a857c);
  }

  .topic-singles__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .topic-chip {
    padding: 0.22rem 0.7rem;
    border: var(--hairline);
    border-radius: var(--radius-full);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-muted, #6b675f);
