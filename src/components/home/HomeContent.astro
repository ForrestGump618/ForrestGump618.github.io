---
/**
 * 首页主体：个人 Hero → 最新笔记（紧凑行）→ 漫览（图表画廊）→ 专题分类 → 实验室。
 * 首页是聚合落地页：只展示一页，分页统一放在归档。
 * 图片只出现在「漫览」，且均来自内容本身。
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import HomeLab from "@/components/home/HomeLab.astro";
import { resolvePostCover } from "@/toolkit/covers";
import { formatDateMachine } from "@/toolkit/posts/formatDate";
import { getReadingStats } from "@/toolkit/posts/readingStats";
import { toPostHref } from "@/toolkit/posts/url";

interface HomeCategory {
  name: string;
  href: string;
  count: number;
  recent: { title: string; href: string }[];
}

interface Props {
  posts: CollectionEntry<"posts">[];
  /** 全量文章池：用于挑选漫览画廊（不受最新列表条数限制） */
  pool?: CollectionEntry<"posts">[];
  categories?: HomeCategory[];
}

const { posts, pool = posts, categories = [] } = Astro.props;

const prepare = (post: CollectionEntry<"posts">) => ({
  post,
  cover: resolvePostCover({
    id: post.id,
    title: post.data.title,
    categories: post.data.categories,
    tags: post.data.tags,
    cover: post.data.cover,
    description: post.data.description,
  }),
  stats: getReadingStats(post.body ?? ""),
  href: toPostHref(post.id),
  dateMachine: formatDateMachine(post.data.date),
  category: post.data.categories?.[0] ?? "笔记",
});

const latest = posts.map(prepare);
const galleryPosts = pool
  .map(prepare)
  .filter((item) => item.cover.band && (item.cover.Image || item.cover.src))
  .slice(0, 3);

// 单篇分类合并为一行快捷入口，避免整卡只装一篇文章
const topicCategories = categories.filter((category) => category.count > 1);
const singleCategories = categories.filter((category) => category.count === 1);
---

<div class="home-opening reveal" style="--reveal-i:0">
  <slot name="profile" />
</div>

<section class="home-list reveal" style="--reveal-i:1" aria-labelledby="latest-heading">
  <div class="section-head">
    <div>
      <h2 class="section-head__title" id="latest-heading">最新笔记</h2>
    </div>
    <a class="section-head__more" href="/archives/">全部笔记<span aria-hidden="true"> →</span></a>
  </div>

  {latest.length === 0 ? (
    <p class="home-empty">
      这里还没有文章。<a href="/archives/">去归档看看</a>
    </p>
  ) : (
    <ol class="post-list">
      {latest.map((item) => (
        <li class="post-row">
          <a class="post-row__link" href={item.href}>
            <span class="post-row__main">
              <span class="post-row__cat">{item.category}</span>
              <span class="post-row__title" title={item.post.data.title}>{item.post.data.title}</span>
            </span>
            <span class="post-row__meta">
              {item.stats.readTime > 0 && (
                <span class="post-row__read">{item.stats.readTime} 分钟</span>
              )}
              <time class="post-row__date" datetime={item.post.data.date.toISOString()}>{item.dateMachine}</time>
            </span>
          </a>
        </li>
      ))}
    </ol>
  )}
</section>

{galleryPosts.length > 0 && (
  <section class="home-gallery" aria-labelledby="gallery-heading">
    <div class="section-head">
      <div>
        <h2 class="section-head__title" id="gallery-heading">漫览</h2>
        <p class="section-head__sub">科研图表与解剖图解，点击图片可放大浏览。</p>
      </div>
    </div>
    <div class="gallery-grid" data-image-zoom-gallery>
      {galleryPosts.map((item, index) => (
        <figure class="gallery-card" data-scroll-reveal style={`--reveal-i:${index}`}>
          <div class="gallery-card__frame">
            <image-zoom class="gallery-card__zoom" data-fill>
              {item.cover.Image ? (
                <Image
                  src={item.cover.Image}
                  alt={item.cover.alt}
                  widths={[320, 480, 640, 960]}
                  sizes="(max-width: 700px) 92vw, 24rem"
                  loading="lazy"
                  decoding="async"
                  class="gallery-card__img"
                />
              ) : (
                <img
                  src={item.cover.src}
                  alt={item.cover.alt}
                  loading="lazy"
                  decoding="async"
                  class="gallery-card__img"
                />
              )}
            </image-zoom>
          </div>
          <figcaption class="gallery-card__body">
            <span class="gallery-card__title">{item.post.data.title}</span>
            <a class="gallery-card__enter" href={item.href}>
              进入原文 <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
            </a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{categories.length > 0 && (
  <section class="home-topics" aria-labelledby="topics-heading">
    <div class="section-head">
      <div>
        <h2 class="section-head__title" id="topics-heading">专题分类</h2>
      </div>
    </div>
    <div class="topic-grid">
      {topicCategories.map((category, index) => (
        <article class="topic-card" data-scroll-reveal style={`--reveal-i:${index % 4}`}>
          <a class="topic-card__head" href={category.href}>
            <span class="topic-card__name">{category.name}</span>
            <span class="topic-card__count">{category.count} 篇</span>
          </a>
          {category.recent.length > 0 && (
            <ul class="topic-card__list">
              {category.recent.slice(0, 3).map((entry) => (
                <li>
                  <a href={entry.href} title={entry.title}>{entry.title}</a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
    {singleCategories.length > 0 && (
      <div class="topic-singles">
        <span class="topic-singles__label">单篇专题</span>
        <div class="topic-singles__chips">
          {singleCategories.map((category) => (
            <a class="topic-chip" href={category.recent[0]?.href ?? category.href}>
              {category.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
)}

<HomeLab />

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .section-head__title {
    margin: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text-color, #23211d);
  }

  .section-head__sub {
    margin: 0.4rem 0 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .section-head__more {
    flex-shrink: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }

  .section-head__more span {
    display: inline-block;
    transition: translate var(--dur-2) var(--ease-out);
  }

  .section-head__more:hover {
    color: var(--primary-color, #7c3b52);
  }

  .section-head__more:hover span {
    translate: 3px 0;
  }

  .home-opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--rhythm-block);
  }

  /* ---------- 最新笔记：紧凑行 ---------- */
  .home-list {
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .post-row {
    border-bottom: var(--hairline);
  }

  .post-row__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.25rem;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .post-row__link:is(:hover, :focus-visible, :active) {
    background: color-mix(in oklab, var(--surface-subtle, #f4f2ee) 55%, transparent);
  }

  .post-row__main {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    min-width: 0;
    transition: translate var(--dur-2) var(--ease-out);
  }

  .post-row__link:is(:hover, :focus-visible) .post-row__main {
    translate: 3px 0;
  }

  .post-row__cat {
    flex: none;
    padding: 0.12rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--surface-tinted);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--primary-color, #7c3b52);
    white-space: nowrap;
  }

  .post-row__title {
    min-width: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-color, #23211d);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }

  .post-row__link:is(:hover, :focus-visible) .post-row__title {
    color: var(--primary-color, #7c3b52);
  }

  .post-row__meta {
    display: flex;
    flex: none;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.74rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .post-row__read {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-row__date {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-2) var(--ease-out);
  }

  .post-row__link:is(:hover, :focus-visible) .post-row__date {
    color: var(--primary-color, #7c3b52);
  }

  .home-empty {
    padding: 2.5rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    color: var(--text-color-subtle, #8a857c);
  }

  .home-empty a {
    color: var(--primary-color, #7c3b52);
  }

  /* ---------- 漫览：图表画廊 ---------- */
  .home-gallery {
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .gallery-card {
    margin: 0;
    min-width: 0;
  }

  /* 论文图表多为白底：统一冷白纸面承接，暗色模式下也保持浅色 */
  .gallery-card__frame {
    aspect-ratio: 4 / 3;
    padding: clamp(0.6rem, 1.6vw, 1rem);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: #fafbfc;
    overflow: hidden;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .gallery-card__zoom {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .gallery-card__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .gallery-card__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem;
    padding-top: 0.8rem;
  }

  .gallery-card__title {
    min-width: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-color, #23211d);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gallery-card__enter {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .gallery-card__enter span {
    transition: translate var(--dur-2) var(--ease-out);
  }

  .gallery-card__enter:hover,
  .gallery-card__enter:focus-visible {
    color: var(--primary-color, #7c3b52);
  }

  .gallery-card__enter:hover span,
  .gallery-card__enter:focus-visible span {
    translate: 3px 0;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .gallery-card:hover .gallery-card__frame {
      border-color: color-mix(in oklab, var(--primary-color, #7c3b52) 35%, var(--border-color));
      box-shadow: var(--shadow-card-hover);
    }

    .gallery-card:hover .gallery-card__img {
      transform: scale(1.02);
    }
  }

  /* ---------- 专题 ---------- */
  .home-topics {
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: var(--hairline);
  }

  .topic-card {
    padding: 1.1rem 0.25rem;
    border-bottom: var(--hairline);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .topic-card:hover {
    background: color-mix(in oklab, var(--surface-subtle) 45%, transparent);
  }

  .topic-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .topic-card__name {
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
    transition: color var(--dur-2) var(--ease-out);
  }

  .topic-card__head:hover .topic-card__name,
  .topic-card__head:focus-visible .topic-card__name {
    color: var(--primary-color, #7c3b52);
  }

  .topic-card__count {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-color-subtle, #8a857c);
  }

  .topic-card__list {
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .topic-card__list a {
    display: block;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }

  .topic-card__list a:hover,
  .topic-card__list a:focus-visible {
    color: var(--primary-color, #7c3b52);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topic-singles {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 1rem 0.25rem 0;
  }

  .topic-singles__label {
    flex: none;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-color-subtle, #8a857c);
  }

  .topic-singles__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .topic-chip {
    padding: 0.22rem 0.7rem;
    border: var(--hairline);
    border-radius: var(--radius-full);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      translate var(--dur-1) var(--ease-press);
  }

  .topic-chip:hover,
  .topic-chip:focus-visible {
    color: var(--primary-color, #7c3b52);
    border-color: color-mix(in oklab, var(--primary-color, #7c3b52) 40%, transparent);
    background: var(--surface-tinted);
    translate: 0 -1px;
  }

  @media (max-width: 567px) {
    .post-row__read {
      display: none;
    }
  }

  @media (min-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  @media (min-width: 980px) {
    .topic-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2.25rem;
    }
  }
</style>