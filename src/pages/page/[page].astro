---
/**
 * 首页分页（/page/2..N）：复用首页的编辑式列表。
 */
import Layout from "@/layouts/Layout.astro";
import HomeContent from "@/components/home/HomeContent.astro";
import { getCollection } from "astro:content";
import themeConfig from "@/theme.config";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts.filter((post) => !post.data.draft);

  const regularPosts = publishedPosts
    .filter((post) => !post.data.sticky)
    .toSorted(
      (a, b) =>
        new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    );

  const pageSize = themeConfig.home?.pageSize ?? 9;

  // 第 1 页由 src/pages/index.astro 输出，这里只生成 /page/2..N
  const pages = paginate(regularPosts, { pageSize });
  return pages.filter((p) => p.params.page !== "1");
}) satisfies GetStaticPaths;

const { page } = Astro.props as {
  page: {
    data: CollectionEntry<"posts">[];
    currentPage: number;
    lastPage: number;
  };
};

const brandConfig = themeConfig.brand ?? {};
const pageTitle = `${brandConfig.title || "Echo"} — ${brandConfig.subtitle || "Learn-Record"} · 第 ${page.currentPage} 页`;
---

<Layout pageTitle={pageTitle} indexPage={true} seoTitle={pageTitle}>
  <Fragment slot="head">
    <meta name="description" content={themeConfig.sidebar?.description} />
  </Fragment>

  <div class="home wrap">
    <HomeContent
      posts={page.data}
      stickyPosts={[]}
      categories={[]}
      pageInfo={{ currentPage: page.currentPage, lastPage: page.lastPage }}
      isFirstPage={false}
    />
  </div>
</Layout>

<style>
  .home {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
</style>
