---
/**
 * 旧首页分页（/page/2..N）已并入归档：这里只生成跳转页，保住历史链接。
 */
import { getCollection } from "astro:content";
import themeConfig from "@/theme.config";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const allPosts = await getCollection("posts");
  const publishedCount = allPosts.filter((post) => !post.data.draft).length;
  const pageSize = themeConfig.home?.pageSize ?? 6;
  const lastPage = Math.max(1, Math.ceil(publishedCount / pageSize));

  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}) satisfies GetStaticPaths;

return Astro.redirect("/archives/");
---