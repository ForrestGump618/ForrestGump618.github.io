---
import Layout from "@/layouts/Layout.astro";
import WalineComments from "@/components/post/WalineComments.svelte";
import { currentLocale } from "@/i18n";
import themeConfig from "@/theme.config";

const commentsConfig = themeConfig.comments || {};
const walineConfig = commentsConfig.waline || {};
const guestbookPath = "/guestbook/";
const pageTitle = "留言板";
const description = "欢迎来到这里，如果你对本站有任何疑问、建议，或者只是想打个招呼，都非常欢迎留言。";
---

<Layout pageTitle={pageTitle} eyebrow="Guestbook" description={description}>
  <div class="wrap guestbook">
    <div class="guestbook__intro">
      <p>
        欢迎来到这里。如果你对本站有任何疑问、建议，或者只是想打个招呼，都非常欢迎留言。
      </p>
      <ul class="guestbook__tips">
        <li>建议填写昵称与邮箱，这样当我回复时你能第一时间收到通知。</li>
        <li>本站留言系统使用 Waline，不强制注册，请放心交流。</li>
        <li>据说在这里留言的人，都会悄悄收获一点好运。</li>
      </ul>
    </div>

    <section class="guestbook__map" aria-labelledby="guestbook-map-title">
      <h2 class="guestbook__title" id="guestbook-map-title">访客地图</h2>
      <script
        type="text/javascript"
        id="clustrmaps"
        src="//clustrmaps.com/map_v2.js?d=WM017qayEgsM35ZHXkb2ZwUMtOGyEc19IGvI_C_dRPU&cl=ffffff&w=a"
        is:inline
      />
      <p class="guestbook__map-sub">世界很大，很高兴在这里与你相遇。</p>
    </section>

    <section class="guestbook__comments" aria-labelledby="guestbook-comments-title">
      <h2 class="guestbook__title" id="guestbook-comments-title">评论</h2>
      <div id="comments" class="comment">
        <WalineComments
          client:visible
          serverURL={walineConfig.serverURL}
          lang={walineConfig.lang || currentLocale}
          dark={walineConfig.dark}
          path={walineConfig.path}
          pagePath={guestbookPath}
        />
      </div>
    </section>
  </div>
</Layout>

<style>
  .guestbook__intro {
    margin-bottom: 2rem;
    max-width: var(--reading-width, 43rem);
  }

  .guestbook__intro p {
    margin: 0 0 1rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.96rem;
    line-height: 1.85;
    color: var(--text-color, #23211d);
  }

  .guestbook__tips {
    margin: 0;
    padding: 0.85rem 1rem 0.85rem 1.6rem;
    border-left: 2px solid var(--border-color, rgb(0 0 0 / 16%));
    background: var(--surface-subtle, #f4f2ee);
    list-style: square;
  }

  .guestbook__tips li {
    margin: 0.3rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--text-color-subtle, #8a857c);
  }

  .guestbook__tips li::marker {
    color: var(--primary-color, #7c3b52);
  }

  .guestbook__map,
  .guestbook__comments {
    margin-top: 2.25rem;
  }

  .guestbook__title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    font-family: var(--font-serif, serif);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
  }

  .guestbook__map-sub {
    margin: 0.5rem 0 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.78rem;
    color: var(--text-color-subtle, #8a857c);
  }
</style>
