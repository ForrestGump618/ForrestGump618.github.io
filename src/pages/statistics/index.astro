---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { t } from "@/i18n";
import { buildSiteStatistics } from "@/toolkit/posts/buildSiteStatistics";
import ArticleStatisticsCharts from "@/components/statistics/ArticleStatisticsCharts.svelte";
import "@/styles/collapse.css";

const allPosts = await getCollection("posts");
const statistics = buildSiteStatistics(allPosts);

const latestMonth = statistics.monthlyPostCounts.at(-1) || null;
const lastUpdated = allPosts
  .map((post) => post.data.date)
  .toSorted((a, b) => b.getTime() - a.getTime())[0];
const year = lastUpdated ? lastUpdated.getFullYear() : new Date().getFullYear();
---

<Layout
  pageTitle={t("statistics.title")}
  eyebrow="Statistics"
  description={`写作与内容统计：${statistics.totalPosts} 篇文章、${statistics.totalCategories} 个分类、${statistics.totalTags} 个标签。`}
>
  <div class="wrap">
    <div class="statistics-kpi" role="list">
      <article class="statistics-kpi-card" role="listitem">
        <div class="statistics-kpi-label">{t("statistics.totalPosts")}</div>
        <div class="statistics-kpi-value">{statistics.totalPosts}</div>
      </article>
      <article class="statistics-kpi-card" role="listitem">
        <div class="statistics-kpi-label">{t("statistics.totalCategories")}</div>
        <div class="statistics-kpi-value">{statistics.totalCategories}</div>
      </article>
      <article class="statistics-kpi-card" role="listitem">
        <div class="statistics-kpi-label">{t("statistics.totalTags")}</div>
        <div class="statistics-kpi-value">{statistics.totalTags}</div>
      </article>
      <article class="statistics-kpi-card" role="listitem">
        <div class="statistics-kpi-label">{t("statistics.topCategory")}</div>
        <div class="statistics-kpi-value statistics-kpi-value-sm">
          {
            statistics.topCategory
              ? `${statistics.topCategory.name} · ${statistics.topCategory.count}`
              : t("post.noContent")
          }
        </div>
      </article>
    </div>

    <p class="statistics-summary">
      {
        latestMonth
          ? t("statistics.latestMonthSummary", {
              month: latestMonth.label,
              count: latestMonth.count,
            })
          : t("post.noContent")
      }
      {lastUpdated && <span class="statistics-summary__meta">· 数据截至 {year} 年</span>}
    </p>

    <ArticleStatisticsCharts
      client:load
      monthlyPostCounts={statistics.monthlyPostCounts}
      categoryCounts={statistics.categoryCounts}
      tagCounts={statistics.tagCounts}
    />
  </div>
</Layout>

<style>
  .statistics-kpi {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0;
    margin: 0 0 1.25rem;
    border-top: 1px solid var(--hairline, rgb(0 0 0 / 8%));
  }

  .statistics-kpi-card {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 8%));
  }

  .statistics-kpi-label {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-color-subtle, #8a857c);
  }

  .statistics-kpi-value {
    margin-top: 0.25rem;
    font-family: var(--font-serif, serif);
    font-size: 1.55rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    color: var(--text-color, #23211d);
  }

  .statistics-kpi-value-sm {
    font-size: 1.02rem;
  }

  .statistics-summary {
    margin: 0 0 1.5rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.86rem;
    line-height: 1.8;
    color: var(--text-color-subtle, #8a857c);
  }

  .statistics-summary__meta {
    margin-left: 0.4rem;
  }

  @media (min-width: 42rem) {
    .statistics-kpi {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 1.25rem;
    }
  }
</style>
