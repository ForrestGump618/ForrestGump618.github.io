---
import Layout from "../../../../layouts/Layout.astro";
import PostList from "@/components/post/PostList.astro";
import { getCollection } from "astro:content";
import { structurePostsByDate } from "@/toolkit/posts/structurePostsByDate";
import { fmtNum } from "@/toolkit/tools/fmtNum";
import { t } from "@/i18n";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const structuredPosts = structurePostsByDate(publishedPosts, {
    daily: false,
  });

  const paths = [];

  for (const year of Object.keys(structuredPosts).map(Number)) {
    const yearData = structuredPosts[year];

    for (let month = 1; month <= 12; month++) {
      const monthPosts = yearData.monthlyData[month]?.posts;
      if (monthPosts && monthPosts.length > 0) {
        paths.push({
          params: {
            year: String(year),
            month: fmtNum(month),
          },
          props: {
            year,
            month,
            posts: monthPosts,
          },
        });
      }
    }
  }

  return paths;
}

const { year, month, posts } = Astro.props as {
  year: number;
  month: number;
  posts: CollectionEntry<"posts">[];
};

const sortedPosts = posts.toSorted(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// 同年其它月份，便于切换
const allPosts = await getCollection("posts");
const monthsInYear = Array.from(
  new Set(
    allPosts
      .filter((post) => !post.data.draft && post.data.date.getFullYear() === year)
      .map((post) => post.data.date.getMonth() + 1),
  ),
).toSorted((a, b) => a - b);
---

<Layout
  pageTitle={`${year} 年 ${month} 月归档`}
  eyebrow="归档"
  description={`${year} 年 ${month} 月共 ${sortedPosts.length} 篇文章。`}
>
  <div class="wrap archive-page">
    <nav class="archive-nav" aria-label="归档导航">
      <a href="/archives/">{t("archive.all")}</a>
      <span aria-hidden="true">/</span>
      <a href={`/archives/${year}/`}>{year} 年</a>
      <span aria-hidden="true">/</span>
      <span class="archive-nav__current">{month} 月</span>
    </nav>

    <p class="month-links">
      {
        monthsInYear.map((item) => (
          <a
            href={`/archives/${year}/${fmtNum(item)}/`}
            class:list={{ "is-current": item === month }}
          >
            {item} 月
          </a>
        ))
      }
    </p>

    <PostList posts={sortedPosts} />

    <nav class="month-pager" aria-label="月份翻页">
      {
        month > 1 ? (
          <a href={`/archives/${year}/${fmtNum(month - 1)}/`}>← 上一月</a>
        ) : (
          <span />
        )
      }
      {
        month < 12 ? (
          <a href={`/archives/${year}/${fmtNum(month + 1)}/`}>下一月 →</a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</Layout>

<style>
  .archive-page {
    max-width: 56rem;
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .archive-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .archive-nav a {
    border: 0;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
  }

  .archive-nav a:hover {
    color: var(--primary-color, #7c3b52);
  }

  .archive-nav__current {
    color: var(--text-color, #23211d);
  }

  .month-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 1.25rem 0 1.75rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
  }

  .month-links a {
    display: inline-flex;
    align-items: center;
    height: 1.9rem;
    padding: 0 0.65rem;
    border: 1px solid transparent;
    border-radius: var(--radius-xs, 2px);
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
  }

  .month-links a:hover {
    background: var(--surface-subtle, #f4f2ee);
    color: var(--text-color, #23211d);
  }

  .month-links a.is-current {
    border-color: var(--line-color, rgb(0 0 0 / 14%));
    background: var(--surface-subtle, #f4f2ee);
    color: var(--text-color, #23211d);
    font-weight: 600;
  }

  .month-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
  }

  .month-pager a {
    border: 0;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
  }

  .month-pager a:hover {
    color: var(--primary-color, #7c3b52);
  }
</style>
