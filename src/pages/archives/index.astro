---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { structurePostsByDate } from "@/toolkit/posts/structurePostsByDate";
import { buildArchiveTimeline } from "@/toolkit/posts/buildArchiveTimeline";
import { toCategoryHref, toPostHref } from "@/toolkit/posts/url";
import { fmtNum } from "@/toolkit/tools/fmtNum";
import { t } from "@/i18n";

// 已发布文章按日期倒序
const allPosts = await getCollection("posts");
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());

const structuredPosts = structurePostsByDate(publishedPosts, { daily: false });

const years = Object.keys(structuredPosts)
  .map(Number)
  .toSorted((a, b) => b - a);

const totalPosts = publishedPosts.length;

// 按年分组生成归档条目
const archiveYears = years.map((year) => {
  const timelineItems = buildArchiveTimeline(
    structuredPosts[year].yearlySummary,
  );

  const months = new Map<
    number,
    {
      label: string;
      count: number;
      posts: {
        title: string;
        href: string;
        day: string;
        dateTime: string;
        category?: string;
      }[];
    }
  >();

  for (const item of timelineItems) {
    const { post, month, monthPostCount } = item;
    const postDate = post.data.date;
    const monthEntry = months.get(month) ?? {
      label: `${year} 年 ${month} 月`,
      count: monthPostCount,
      posts: [],
    };

    monthEntry.posts.push({
      title: post.data.title || t("post.noContent"),
      href: toPostHref(post.id),
      day: `${fmtNum(month)}-${fmtNum(postDate.getDate())}`,
      dateTime: postDate.toISOString(),
      category: post.data.categories?.at(-1),
    });

    months.set(month, monthEntry);
  }

  return {
    year,
    href: `/archives/${year}/`,
    count: timelineItems.length,
    months: Array.from(months.entries())
      .toSorted((a, b) => b[0] - a[0])
      .map(([month, entry]) => ({
        month,
        href: `/archives/${year}/${fmtNum(month)}/`,
        ...entry,
      })),
  };
});
---

<Layout
  pageTitle={t("archive.title")}
  description={`Echo 全部 ${totalPosts} 篇文章的时间归档，跨 ${years.length} 个年份。`}
>
  <div class="wrap archive-page">
    <p class="archive-summary">
      {t("common.total")} <strong>{totalPosts}</strong> 篇文章，跨 {years.length} 年。
    </p>

    {
      archiveYears.map((yearEntry) => (
        <section class="archive-year">
          <header class="archive-year__head">
            <h2>
              <a href={yearEntry.href}>{yearEntry.year}</a>
            </h2>
            <span class="archive-year__count">{yearEntry.count} 篇</span>
          </header>

          {yearEntry.months.map((month) => (
            <div class="archive-month">
              <h3 class="archive-month__title">
                <a href={month.href}>{month.label}</a>
                <span class="archive-month__count">{month.count} 篇</span>
              </h3>
              <ul class="archive-list">
                {month.posts.map((post) => (
                  <li>
                    <a class="archive-item" href={post.href}>
                      <time datetime={post.dateTime}>{post.day}</time>
                      <span class="archive-item__title">{post.title}</span>
                      {post.category && (
                        <span class="archive-item__cat">{post.category}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .archive-page {
    max-width: 56rem;
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .archive-summary {
    margin: 0 0 2.5rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.82rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .archive-summary strong {
    font-weight: 600;
    color: var(--text-color, #23211d);
  }

  .archive-year + .archive-year {
    margin-top: 3rem;
  }

  .archive-year__head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line-color, rgb(0 0 0 / 14%));
  }

  .archive-year__head h2 {
    margin: 0;
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .archive-year__head a {
    border: 0;
    text-decoration: none;
    color: var(--text-color, #23211d);
  }

  .archive-year__head a:hover {
    color: var(--primary-color, #7c3b52);
  }

  .archive-year__count {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .archive-month {
    margin-top: 1.75rem;
  }

  .archive-month__title {
    margin: 0 0 0.65rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-color-subtle, #8a857c);
  }

  .archive-month__title a {
    border: 0;
    text-decoration: none;
    color: inherit;
  }

  .archive-month__title a:hover {
    color: var(--primary-color, #7c3b52);
  }

  .archive-month__count {
    margin-left: 0.45rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-item {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.55rem 0.1rem;
    border: 0;
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    text-decoration: none;
    color: inherit;
  }

  .archive-item time {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-color-subtle, #8a857c);
  }

  .archive-item__title {
    font-family: var(--font-serif, Georgia, "Noto Serif SC", serif);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--text-color, #23211d);
    overflow-wrap: break-word;
    transition: color 0.18s ease;
  }

  .archive-item:hover .archive-item__title {
    color: var(--primary-color, #7c3b52);
  }

  .archive-item__cat {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.7rem;
    color: var(--primary-color, #7c3b52);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .archive-item {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .archive-item__cat {
      display: none;
    }
  }
</style>
