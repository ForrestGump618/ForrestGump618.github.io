---
/**
 * 文章详情页：编辑式长文阅读。
 * 结构：面包屑 → 标题区 → 封面（真实图片才显示）→ 正文 + 右侧目录 → 标签 → 相关阅读 → 版权 → 上下篇 → 评论。
 */
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/post/Breadcrumb.astro";
import PostFooter from "@/components/post/PostFooter.astro";
import PostNav from "@/components/post/PostNav.astro";
import AiSummaryCard from "@/components/post/AiSummaryCard.astro";
import ArticleToc from "@/components/post/ArticleToc.astro";
import ReadingProgress from "@/components/post/ReadingProgress.astro";
import WalineComments from "@/components/post/WalineComments.svelte";
import CoverMedia from "@/components/media/CoverMedia.astro";
import { avatar } from "@/components/Images.astro";
import { currentLocale } from "@/i18n";
import { getCollection, render } from "astro:content";
import themeConfig from "@/theme.config";
import type { TocItem } from "@/components/sidebar/SidebarTypes";
import type { EncryptedData } from "@/toolkit/encryption/types";
import { encryptContent } from "@/toolkit/encryption/crypto";
import { createPostContentContainer } from "@/toolkit/posts/createPostContentContainer";
import { formatDateLong, formatDateShort } from "@/toolkit/posts/formatDate";
import { getReadingStats, toReadableText } from "@/toolkit/posts/readingStats";
import { toPostHref, toTagHref } from "@/toolkit/posts/url";
import { resolvePostCover } from "@/toolkit/covers";
import { wrapRenderedCodeBlocks } from "@/toolkit/wrapRenderedCodeBlocks";
import { wrapRenderedImages } from "@/toolkit/wrapRenderedImages";
import { wrapCodeGroups } from "@/toolkit/wrapCodeGroups";
import { wrapExternalLinks } from "@/toolkit/wrapExternalLinks";
import { wrapRenderedTables } from "@/toolkit/wrapRenderedTables";

import "@/styles/post.css";
import "katex/dist/katex-swap.min.css";
import "@/styles/spoiler.css";

import EncryptedPostContent from "@/components/encrypted/EncryptedPost.svelte";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = posts
    .filter((post) => !post.data.draft)
    .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const container = await createPostContentContainer();

  return Promise.all(
    sortedPosts.map(async (post, index) => {
      const prevPost = index > 0 ? sortedPosts[index - 1] : undefined;
      const nextPost =
        index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined;

      const categories = post.data.categories ?? [];
      const relatedPosts =
        categories.length > 0
          ? sortedPosts
              .filter(
                (p) =>
                  p.id !== post.id &&
                  p.data.categories?.some((category) => categories.includes(category)),
              )
              .slice(0, 6)
              .map((p) => ({
                slug: p.id,
                title: p.data.title,
                date: p.data.date,
                category: p.data.categories?.[0],
              }))
          : [];

      let encryptedContent: EncryptedData | undefined;
      let encryptedToc: EncryptedData | undefined;
      let renderedContentHtml: string | undefined;
      let isEncrypted = false;

      const { Content, headings } = await render(post);

      const renderedHtml = wrapExternalLinks(
        wrapRenderedImages(
          wrapRenderedTables(
            wrapCodeGroups(wrapRenderedCodeBlocks(await container.renderToString(Content))),
          ),
        ),
        { siteUrl: import.meta.env.SITE },
      );

      if (post.data.encrypted && post.data.password) {
        isEncrypted = true;
        encryptedContent = await encryptContent(renderedHtml, post.data.password);

        const tocData = headings.map((heading) => ({
          id: heading.slug,
          text: heading.text,
          level: heading.depth,
        }));

        if (tocData.length > 0) {
          encryptedToc = await encryptContent(JSON.stringify(tocData), post.data.password);
        }
      } else {
        renderedContentHtml = renderedHtml;
      }

      return {
        params: { slug: post.id },
        props: {
          post,
          prevPost: prevPost
            ? {
                title: prevPost.data.title,
                slug: prevPost.id,
                category: prevPost.data.categories?.[0],
              }
            : undefined,
          nextPost: nextPost
            ? {
                title: nextPost.data.title,
                slug: nextPost.id,
                category: nextPost.data.categories?.[0],
              }
            : undefined,
          relatedPosts,
          isEncrypted,
          renderedContentHtml,
          encryptedContent,
          encryptedToc,
          headings,
        },
      };
    }),
  );
}

interface Props {
  post: import("astro:content").CollectionEntry<"posts">;
  prevPost?: {
    title: string;
    slug: string;
    category?: string;
  };
  nextPost?: {
    title: string;
    slug: string;
    category?: string;
  };
  relatedPosts: {
    slug: string;
    title: string;
    date: Date;
    category?: string;
  }[];
  isEncrypted: boolean;
  renderedContentHtml?: string;
  encryptedContent?: EncryptedData;
  encryptedToc?: EncryptedData;
  headings: import("astro:content").RenderResult["headings"];
}

const {
  post,
  prevPost,
  nextPost,
  relatedPosts,
  isEncrypted,
  renderedContentHtml,
  encryptedContent,
  encryptedToc,
  headings,
} = Astro.props as Props;

const toc: TocItem[] = isEncrypted
  ? []
  : headings.map((heading) => ({
      id: heading.slug,
      text: heading.text,
      level: heading.depth,
    }));

const stats = getReadingStats(post.body ?? "");

const siteConfig = themeConfig.sidebar ?? {};
const author = siteConfig.author ?? "";
const siteName = themeConfig.siteName ?? "Echo";
const commentsConfig = themeConfig.comments ?? {};
const walineConfig = commentsConfig.waline ?? {};
const commentsEnabled = commentsConfig.enable !== false;

const hycConfig = themeConfig.hyc ?? {};
const aiSummaryConfig = hycConfig.aiSummary ?? {};
const aiSummaryEnable = aiSummaryConfig.enable !== false;
const aiSummaryTitle = aiSummaryConfig.title ?? "AI 摘要";
const aiSummaryShowModel = aiSummaryConfig.showModel === true;

interface PostAiSummary {
  content: string | null;
  model: string | null;
}

let aiSummary: PostAiSummary | null = null;

if (!isEncrypted && hycConfig.enable === true && aiSummaryEnable) {
  try {
    const { getPostSummary } = await import("@hyacine/cli/api");

    if (typeof getPostSummary !== "function") {
      throw new TypeError("getPostSummary is not available in current @hyacine/cli");
    }

    const summaryResult = (await getPostSummary(post.id)) as {
      summary?: { content?: string | null; model?: string | null };
    } | null;

    if (summaryResult?.summary?.content) {
      aiSummary = {
        content: summaryResult.summary.content,
        model: summaryResult.summary.model ?? null,
      };
    }
  } catch {
    aiSummary = null;
  }
}

const postPath = toPostHref(post.id);
const permalink = import.meta.env.SITE
  ? new URL(postPath, import.meta.env.SITE).toString()
  : postPath;

const postDescription =
  post.data.description || toReadableText(post.body ?? "").slice(0, 150);

const cover = resolvePostCover({
  id: post.id,
  title: post.data.title,
  categories: post.data.categories,
  tags: post.data.tags,
  cover: post.data.cover,
  description: post.data.description,
});
const hasHeroImage =
  (cover.kind === "photograph" || cover.kind === "scientific" || cover.kind === "illustration") &&
  Boolean(cover.Image || cover.src);

const seoImage = cover.Image ?? cover.src ?? undefined;
---

<Layout
  pageTitle={post.data.title}
  hidePageHeader={true}
  pageCover={seoImage}
  description={postDescription}
  seoType="article"
  publishedTime={new Date(post.data.date).toISOString()}
  modifiedTime={post.data.updated ? new Date(post.data.updated).toISOString() : undefined}
  tags={post.data.tags ?? undefined}
>
  <Fragment slot="head">
    <meta name="description" content={postDescription} />
    {isEncrypted && <meta name="robots" content="noindex, nofollow" />}
  </Fragment>

  <ReadingProgress />

  <div class="article wrap" data-pagefind-ignore={isEncrypted ? "all" : undefined}>
    <Breadcrumb categories={post.data.categories ?? undefined} />

    <article
      itemscope
      itemtype="http://schema.org/Article"
      class="post"
      data-pagefind-body={!isEncrypted}
      lang={currentLocale}
    >
      <link itemprop="mainEntityOfPage" href={permalink} />

      <span hidden itemprop="author" itemscope itemtype="http://schema.org/Person">
        <meta itemprop="image" content={avatar.src} />
        <meta itemprop="name" content={author} />
        <meta itemprop="description" content={siteName} />
      </span>

      <span hidden itemprop="publisher" itemscope itemtype="http://schema.org/Organization">
        <meta itemprop="name" content={siteName} />
      </span>

      <header class="post-head">
        {post.data.categories && post.data.categories.length > 0 && (
          <p class="post-head__eyebrow">
            {post.data.categories.map((category) => (
              <a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
            ))}
          </p>
        )}

        <h1 class="post-head__title" itemprop="headline">{post.data.title}</h1>

        <p class="post-head__meta">
          <time datetime={new Date(post.data.date).toISOString()} itemprop="datePublished">
            {formatDateLong(new Date(post.data.date))}
          </time>
          {post.data.updated && (
            <>
              <span class="post-head__dot" aria-hidden="true">·</span>
              <span>更新于 {formatDateShort(new Date(post.data.updated))}</span>
            </>
          )}
          {stats.readTime > 0 && (
            <>
              <span class="post-head__dot" aria-hidden="true">·</span>
              <span>约 {stats.readTime} 分钟</span>
            </>
          )}
          {stats.wordCount > 0 && (
            <>
              <span class="post-head__dot" aria-hidden="true">·</span>
              <span>{stats.wordCount.toLocaleString("zh-CN")} 字</span>
            </>
          )}
        </p>
      </header>

      {hasHeroImage && (
        <figure class="post-cover">
          <CoverMedia
            cover={cover}
            title={post.data.title}
            variant="wide"
            eager={true}
            sizes="(max-width: 900px) 92vw, 60rem"
          />
        </figure>
      )}

      {!isEncrypted && aiSummary?.content && (
        <AiSummaryCard
          summary={aiSummary.content}
          model={aiSummary.model}
          title={aiSummaryTitle}
          showModel={aiSummaryShowModel}
        />
      )}

      <ArticleToc toc={toc} variant="mobile" />

      <div class="article-layout">
        <div class="article-body">
          <div
            class="body md"
            itemprop="articleBody"
            id="article-body"
          >
            {
              isEncrypted && encryptedContent ? (
                <EncryptedPostContent
                  client:load
                  encryptedContent={encryptedContent}
                  encryptedToc={encryptedToc}
                  title={post.data.title}
                />
              ) : (
                <div class="post-content" set:html={renderedContentHtml ?? ""} />
              )
            }
          </div>

          {!isEncrypted && post.data.tags && post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <a href={toTagHref(tag)} rel="tag">
                  <i class="icon i-ri-price-tag-3-line" aria-hidden="true" />
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>

        {!isEncrypted && <ArticleToc toc={toc} variant="desktop" />}
      </div>

      {relatedPosts.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <h2 class="related__title" id="related-heading">相关阅读</h2>
          <ul class="related__list">
            {relatedPosts.map((related) => (
              <li>
                <a href={toPostHref(related.slug)}>
                  <span class="related__date">{formatDateShort(new Date(related.date))}</span>
                  <span class="related__text">{related.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <PostFooter
        date={post.data.date}
        updated={post.data.updated}
        permalink={permalink}
        title={post.data.title}
        author={author}
        siteName={siteName}
        showCopyright={true}
        showReward={false}
        license={post.data.license}
      />
    </article>
  </div>

  <div class="wrap">
    <PostNav prevPost={prevPost} nextPost={nextPost} />
  </div>

  {
    !isEncrypted && commentsEnabled && (
      <div id="comments" class="comment wrap">
        <WalineComments
          client:visible
          serverURL={walineConfig.serverURL}
          lang={walineConfig.lang || currentLocale}
          dark={walineConfig.dark}
          path={walineConfig.path}
          pagePath={postPath}
        />
      </div>
    )
  }
</Layout>
