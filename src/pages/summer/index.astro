---
import Layout from "@/layouts/Layout.astro";

const pageTitle = "医学推免信息汇总";
const description = "医学推免相关资源：医院排行、导师信息查询与导师数据库，持续更新。";

const sections = [
  {
    title: "医院排行",
    links: [
      {
        href: "https://rank.cn-healthcare.com/",
        label: "2022 年度复旦版中国医院排行榜",
      },
      {
        href: "https://rank.cn-healthcare.com/stem/medical-university",
        label: "中国医院 / 中国医学院校科技量值",
      },
      {
        href: "https://research-hospital.cn-healthcare.com/result/hospitals",
        label: "2023 年研究型医院评价遴选结果",
      },
      {
        href: "https://innovation-rank.cn-healthcare.com/comprehensive-ranking",
        label: "2022 年度全国综合榜单 · 中国医院创新转化排行榜",
      },
      {
        href: "https://rank.cn-healthcare.com/nsfc",
        label: "2022 年度全国医院国家自然基金立项数据排行榜",
      },
    ],
  },
  {
    title: "导师相关信息查询",
    links: [
      { href: "http://www.globalauthorid.com/", label: "全球学者库" },
      { href: "https://www.aminer.cn/", label: "Aminer · 学者大数据分析" },
      { href: "https://www.cnki.net/", label: "CNKI（可查询公开的学位论文）" },
    ],
  },
  {
    title: "导师数据库",
    links: [
      {
        href: "http://202.195.181.96/gmis5/dsfc/w_dsfc",
        label: "南京医科大学研究生院 · 导师风采",
      },
      {
        href: "https://med.nju.edu.cn/10649/list.htm",
        label: "南京大学医学院 · 导师名单",
      },
      {
        href: "http://pumc.teacher.360eol.com/",
        label: "北京协和医院 · 导师风采",
      },
    ],
  },
];
---

<Layout pageTitle={pageTitle} eyebrow="Resources" description={description}>
  <div class="wrap summer">
    {
      sections.map((section) => (
        <section class="summer__section">
          <h2 class="summer__title">{section.title}</h2>
          <ul class="summer__list">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <i class="i-ri-arrow-right-up-line" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="summer__note">持续更新中，欢迎补充。</p>
  </div>
</Layout>

<style>
  .summer__section {
    margin-bottom: 2.25rem;
  }

  .summer__title {
    margin: 0 0 0.75rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    font-family: var(--font-serif, serif);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
  }

  .summer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .summer__list li {
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 6%));
  }

  .summer__list li:last-child {
    border-bottom: 0;
  }

  .summer__list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.62rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-color, #23211d);
    text-decoration: none;
    transition: color 0.2s var(--ease-out, ease);
  }

  .summer__list a:hover {
    color: var(--primary-color, #7c3b52);
  }

  .summer__list a i {
    flex: none;
    font-size: 0.85rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .summer__note {
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.8rem;
    color: var(--text-color-subtle, #8a857c);
  }
</style>
