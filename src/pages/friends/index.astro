---
import { Code } from "astro:components";
import Layout from "@/layouts/Layout.astro";
import FriendLinks from "@/components/friends/FriendLinks.astro";
import FriendRules from "@/content/friends-rules.md";
import WalineComments from "@/components/post/WalineComments.svelte";
import { currentLocale } from "@/i18n";
import themeConfig from "@/theme.config";
import astroConfig from "../../../astro.config.mjs";

const friendsConfig = themeConfig.friends;
const friendLinks = friendsConfig?.links ?? [];
const pageTitle = friendsConfig?.title ?? "友链";
const pageDescription =
  friendsConfig?.description ?? "欢迎交换友链，一起记录与分享。";
const commentsConfig = themeConfig.comments || {};
const walineConfig = commentsConfig.waline || {};
const friendsPath = "/friends/";
const siteUrl = import.meta.env.SITE?.toString() ?? "";
const codeThemes = astroConfig.markdown?.shikiConfig?.themes;
const friendsSnippet = {
  url: siteUrl,
  title: themeConfig.brand?.title ?? themeConfig.siteName,
  desc: themeConfig.sidebar?.description ?? "",
  author: themeConfig.sidebar?.author ?? "",
  ...(friendsConfig?.avatar ? { avatar: friendsConfig.avatar } : {}),
  ...(friendsConfig?.color ? { color: friendsConfig.color } : {}),
  ...(friendsConfig?.siteImage ? { siteImage: friendsConfig.siteImage } : {}),
};
const friendsJson = JSON.stringify(friendsSnippet, null, 2);
---

<Layout pageTitle={pageTitle} eyebrow="Friends" description={pageDescription}>
  <div class="wrap friends">
    <section class="friends__section">
      <h2 class="friends__title">友链规则</h2>
      <div class="friends__rules">
        <FriendRules />
      </div>
    </section>

    <section class="friends__section">
      <h2 class="friends__title">友链配置示例</h2>
      <p class="friends__hint">
        添加本站时，请将下面内容追加到自己的 links 配置中。
      </p>
      <code-block>
        <Code
          code={friendsJson}
          lang="json"
          themes={codeThemes}
          class="friends__code"
        />
      </code-block>
    </section>

    <section class="friends__section">
      <h2 class="friends__title">友链列表</h2>
      <FriendLinks links={friendLinks} />
    </section>

    {
      friendsConfig?.comments && commentsConfig.enable !== false && (
        <section class="friends__section" id="comments">
          <h2 class="friends__title">评论区</h2>
          <div class="comment">
            <WalineComments
              client:visible
              serverURL={walineConfig.serverURL}
              lang={walineConfig.lang || currentLocale}
              dark={walineConfig.dark}
              path={walineConfig.path}
              pagePath={friendsPath}
            />
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .friends__section {
    margin-bottom: 2.25rem;
  }

  .friends__title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    font-family: var(--font-serif, serif);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
  }

  .friends__hint {
    margin: 0 0 0.9rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text-color-subtle, #8a857c);
  }

  .friends__rules {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-color, #23211d);
  }

  .friends__rules :global(p) {
    margin: 0 0 0.7rem;
  }

  .friends__rules :global(ul) {
    margin: 0;
    padding-left: 1.2rem;
  }

  .friends__rules :global(li) {
    margin: 0.35rem 0;
  }

  .friends__rules :global(li::marker) {
    color: var(--primary-color, #7c3b52);
  }

  .friends__rules :global(strong) {
    color: var(--text-color, #23211d);
  }

  .friends__rules :global(a) {
    color: var(--link-color, var(--primary-color, #7c3b52));
  }

  .friends__code :global(pre) {
    margin: 0;
    overflow-x: auto;
  }
</style>
