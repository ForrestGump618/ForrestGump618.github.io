---
import Layout from "../../layouts/Layout.astro";
import PostList from "@/components/post/PostList.astro";
import { getCollection } from "astro:content";
import { currentLocale, getT } from "@/i18n";
import { toCategoryHref } from "@/toolkit/posts/url";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts.filter((post) => !post.data.draft);

  const categorySet = new Set<string>();
  publishedPosts.forEach((post) => {
    const categories = post.data.categories || [];
    categories.forEach((cat) => categorySet.add(cat));
  });

  return Array.from(categorySet).map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props as { category: string };
const t = getT(currentLocale);

const allPosts = await getCollection("posts");
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 该分类下的文章（含子分类）
const postsInCategory = publishedPosts
  .filter((post) => (post.data.categories || []).includes(category))
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 上级分类（用于面包屑）
function getParentCategories(categoryName: string): string[] {
  const parents: string[] = [];
  for (const post of publishedPosts) {
    const categories = post.data.categories || [];
    const index = categories.indexOf(categoryName);
    if (index > 0) {
      for (let i = 0; i < index; i++) {
        if (!parents.includes(categories[i])) {
          parents.push(categories[i]);
        }
      }
    }
  }
  return parents;
}

const parentCategories = getParentCategories(category);
---

<Layout
  pageTitle={category}
  eyebrow="分类"
  description={`${category} 分类下的 ${postsInCategory.length} 篇文章。`}
>
  <div class="wrap taxonomy-page">
    <nav class="taxonomy-nav" aria-label="分类路径">
      <a href="/categories/">{t("category.all")}</a>
      {
        parentCategories.map((parent) => (
          <>
            <span aria-hidden="true">/</span>
            <a href={toCategoryHref(parent)}>{parent}</a>
          </>
        ))
      }
      <span aria-hidden="true">/</span>
      <span class="taxonomy-nav__current">{category}</span>
    </nav>

    <PostList posts={postsInCategory} showCategory={false} />
  </div>
</Layout>

<style>
  .taxonomy-page {
    max-width: 56rem;
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .taxonomy-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .taxonomy-nav a {
    border: 0;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
  }

  .taxonomy-nav a:hover {
    color: var(--primary-color, #7c3b52);
  }

  .taxonomy-nav__current {
    color: var(--text-color, #23211d);
  }
</style>
