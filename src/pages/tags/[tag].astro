---
import Layout from "../../layouts/Layout.astro";
import PostList from "@/components/post/PostList.astro";
import { getCollection } from "astro:content";
import { toTagSlug } from "@/toolkit/posts/url";
import { t } from "@/i18n";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts.filter((post) => !post.data.draft);

  const tagSet = new Set<string>();
  publishedPosts.forEach((post) => {
    const tags = post.data.tags || [];
    tags.forEach((tag) => tagSet.add(tag));
  });

  return Array.from(tagSet).map((tag) => ({
    params: { tag: toTagSlug(tag) },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

const allPosts = await getCollection("posts");
const publishedPosts = allPosts.filter((post) => !post.data.draft);

const postsWithTag = publishedPosts
  .filter((post) => (post.data.tags || []).includes(tag))
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  pageTitle={tag}
  eyebrow="标签"
  description={`带有「${tag}」标签的 ${postsWithTag.length} 篇文章。`}
>
  <div class="wrap taxonomy-page">
    <nav class="taxonomy-nav" aria-label="标签路径">
      <a href="/tags/">{t("tags.allTags")}</a>
      <span aria-hidden="true">/</span>
      <span class="taxonomy-nav__current">#{tag}</span>
    </nav>

    <PostList posts={postsWithTag} />
  </div>
</Layout>

<style>
  .taxonomy-page {
    max-width: 56rem;
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .taxonomy-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-subtle, #8a857c);
  }

  .taxonomy-nav a {
    border: 0;
    color: var(--text-color-muted, #6b675f);
    text-decoration: none;
  }

  .taxonomy-nav a:hover {
    color: var(--primary-color, #7c3b52);
  }

  .taxonomy-nav__current {
    color: var(--text-color, #23211d);
  }
</style>
