---
import Layout from "@/layouts/Layout.astro";
import { starCategories } from "@/data/stars";

const description = "收集了一些有用的网站和工具，按类别整理如下。";
const totalCount = starCategories.reduce((sum, category) => sum + category.items.length, 0);
---

<Layout pageTitle="我的收藏" description={description}>
  <div class="wrap">
    <div class="stars-toolbar" data-stars-toolbar hidden>
      <label class="stars-search">
        <span class="i-ri-search-line stars-search__icon" aria-hidden="true"></span>
        <input
          type="search"
          class="stars-search__input"
          placeholder="搜索名称、简介或分类…"
          aria-label="搜索收藏"
          autocomplete="off"
          data-stars-input
        />
        <button type="button" class="stars-search__clear" aria-label="清除搜索" data-stars-clear hidden>
          <span class="i-ri-close-line" aria-hidden="true"></span>
        </button>
      </label>
      <p class="stars-count" role="status" aria-live="polite" data-stars-count>
        共 {totalCount} 个收藏
      </p>
    </div>

    {
      starCategories.map((category) => (
        <section class="stars-section" data-stars-section>
          <h2 class="stars-section__title" id={category.key}>
            {category.label}
          </h2>
          <ul class="stars-grid">
            {category.items.map((item) => (
              <li
                data-stars-item
                data-text={`${item.nickname} ${item.content} ${category.label}`.toLowerCase()}
              >
                <a
                  href={item.site}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="star-card"
                >
                  <span class="star-card__name">{item.nickname}</span>
                  <span class="star-card__desc">{item.content}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="stars-empty" data-stars-empty hidden>
      <p>没有找到匹配的收藏。</p>
      <button type="button" class="stars-empty__reset" data-stars-reset>清除搜索</button>
    </div>
  </div>
</Layout>

<script>
  const initStarsFilter = () => {
    const toolbar = document.querySelector<HTMLElement>("[data-stars-toolbar]");
    const input = document.querySelector<HTMLInputElement>("[data-stars-input]");
    const clearButton = document.querySelector<HTMLButtonElement>("[data-stars-clear]");
    const count = document.querySelector<HTMLElement>("[data-stars-count]");
    const empty = document.querySelector<HTMLElement>("[data-stars-empty]");
    const resetButton = document.querySelector<HTMLButtonElement>("[data-stars-reset]");
    const items = [...document.querySelectorAll<HTMLElement>("[data-stars-item]")];
    const sections = [...document.querySelectorAll<HTMLElement>("[data-stars-section]")];

    if (!toolbar || !input || !count || !empty || items.length === 0) {
      return;
    }

    // 渐进增强：脚本可用时才展示搜索栏
    toolbar.hidden = false;
    const total = items.length;

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let matched = 0;

      for (const item of items) {
        const hit = !query || (item.dataset.text ?? "").includes(query);
        const wasHidden = item.hidden;
        item.hidden = !hit;
        if (hit) {
          matched += 1;
          // 重新出现的卡片淡入，让筛选结果的变化可感知
          if (wasHidden) {
            item.classList.remove("stars-item-in");
            void item.offsetWidth;
            item.classList.add("stars-item-in");
          }
        }
      }

      for (const section of sections) {
        const visible = section.querySelector("[data-stars-item]:not([hidden])");
        section.hidden = !visible;
      }

      count.textContent = query ? `匹配 ${matched} / ${total} 个收藏` : `共 ${total} 个收藏`;
      empty.hidden = matched > 0;
      if (clearButton) {
        clearButton.hidden = !query;
      }
    };

    const reset = () => {
      input.value = "";
      apply();
      input.focus();
    };

    input.addEventListener("input", apply);
    clearButton?.addEventListener("click", reset);
    resetButton?.addEventListener("click", reset);
    apply();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStarsFilter, { once: true });
  } else {
    initStarsFilter();
  }
</script>

<style>
  .stars-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 2rem;
  }

  .stars-search {
    display: flex;
    flex: 1 1 16rem;
    align-items: center;
    gap: 0.5rem;
    max-width: 26rem;
    padding: 0 0.8rem;
    border: var(--hairline);
    border-radius: var(--radius-full, 999px);
    background: var(--surface-raised, #fff);
    transition: border-color 0.2s var(--ease-out, ease);
  }

  .stars-search:focus-within {
    border-color: var(--primary-color, #7c3b52);
  }

  .stars-search__icon {
    flex: none;
    color: var(--text-color-subtle, #8a857c);
    font-size: 0.9rem;
  }

  .stars-search__input {
    flex: 1;
    min-width: 0;
    min-height: 2.5rem;
    border: 0;
    background: transparent;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.86rem;
    color: var(--text-color, #23211d);
    outline: none;
  }

  .stars-search__input::placeholder {
    color: var(--text-color-subtle, #8a857c);
  }

  .stars-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .stars-search__clear {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-color-subtle, #8a857c);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out, ease),
      background-color 0.2s var(--ease-out, ease);
  }

  .stars-search__clear:hover {
    color: var(--primary-color, #7c3b52);
    background: var(--surface-tinted);
  }

  .stars-count {
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    color: var(--text-color-subtle, #8a857c);
    font-variant-numeric: tabular-nums;
  }

  .stars-section {
    margin-bottom: 2.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stars-item-in {
      animation: stars-item-in var(--dur-3, 0.3s) var(--ease-out, ease) both;
    }

    @keyframes stars-item-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  .stars-section__title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: var(--hairline);
    font-family: var(--font-serif, serif);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-color, #23211d);
  }

  .stars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .star-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.7rem 0.85rem;
    border: var(--hairline);
    border-radius: var(--radius-sm, 4px);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease-out, ease),
      background-color 0.2s var(--ease-out, ease);
  }

  .star-card:hover {
    border-color: var(--border-color, rgb(0 0 0 / 16%));
    background: var(--surface-subtle, #f4f2ee);
  }

  .star-card__name {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
  }

  .star-card:hover .star-card__name {
    color: var(--primary-color, #7c3b52);
  }

  .star-card__desc {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--text-color-subtle, #8a857c);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .stars-empty {
    padding: 3rem 0;
    text-align: center;
    font-family: var(--font-sans, system-ui, sans-serif);
    color: var(--text-color-subtle, #8a857c);
  }

  .stars-empty p {
    margin: 0 0 1rem;
  }

  .stars-empty__reset {
    padding: 0.45rem 1.1rem;
    border: var(--hairline);
    border-radius: var(--radius-full, 999px);
    background: var(--surface-raised, #fff);
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--text-color, #23211d);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out, ease),
      color 0.2s var(--ease-out, ease);
  }

  .stars-empty__reset:hover {
    border-color: var(--primary-color, #7c3b52);
    color: var(--primary-color, #7c3b52);
  }
</style>