---
import Layout from "@/layouts/Layout.astro";
import { starCategories } from "@/data/stars";

const description = "收集了一些有用的网站和工具，按类别整理如下。";
---

<Layout pageTitle="我的收藏" eyebrow="Bookmarks" description={description}>
  <div class="wrap">
    {
      starCategories.map((category) => (
        <section class="stars-section">
          <h2 class="stars-section__title" id={category.key}>
            {category.label}
          </h2>
          <ul class="stars-grid">
            {category.items.map((item) => (
              <li>
                <a
                  href={item.site}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="star-card"
                >
                  <span class="star-card__name">{item.nickname}</span>
                  <span class="star-card__desc">{item.content}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .stars-section {
    margin-bottom: 2.5rem;
  }

  .stars-section__title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    font-family: var(--font-serif, serif);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-color, #23211d);
  }

  .stars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .star-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--hairline, rgb(0 0 0 / 8%));
    border-radius: var(--radius-sm, 4px);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease-out, ease),
      background-color 0.2s var(--ease-out, ease);
  }

  .star-card:hover {
    border-color: var(--border-color, rgb(0 0 0 / 16%));
    background: var(--surface-subtle, #f4f2ee);
  }

  .star-card__name {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-color, #23211d);
  }

  .star-card:hover .star-card__name {
    color: var(--primary-color, #7c3b52);
  }

  .star-card__desc {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--text-color-subtle, #8a857c);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 567px) {
    .stars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
