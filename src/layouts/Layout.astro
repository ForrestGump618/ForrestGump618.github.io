---
/**
 * 站点外壳：主题引导、SEO、导航、页面标题区、页脚与全局脚本。
 *
 * 设计取向：编辑式极简。裁掉首页巨幅头图、波浪、加载动画、悬浮工具栏与三栏侧栏，
 * 只保留阅读需要的东西；页面自身负责正文容器与内容排版。
 */
import Analytics from "@/components/Analytics.astro";
import CodeBlock from "@/components/CodeBlock.svelte";
import Footer from "@/components/footer/Footer.astro";
import Icons from "@/components/Icons.svelte";
import ImageZoom from "@/components/ImageZoom.svelte";
import NavBar from "@/components/navbar/NavBar.svelte";
import SearchPage from "@/components/search/SearchPage.svelte";
import SEO from "@/components/SEO.astro";
import PageHeader from "@/components/shell/PageHeader.astro";
import type { RelatedPost, TocItem, QuickNavigation } from "@/components/sidebar/SidebarTypes";
import { currentLocale } from "@/i18n";
import themeConfig from "@/theme.config.ts";

import "@vtbag/element-crossing?url";
import "@/styles/view-transition.css";
import "@/styles/palette.css";
import "@/styles/tokens.css";
import "@/styles/style.css";
import "@/styles/mdx-components.css";
import "@/styles/icons.css";

import type { ImageMetadata } from "astro";

interface PostMeta {
  date: Date;
  wordCount: number;
  readTime: number;
}

interface Props {
  toc?: TocItem[];
  relatedPosts?: RelatedPost[];
  currentSlug?: string;
  navigation?: QuickNavigation;
  pageTitle?: string;
  postMeta?: PostMeta;
  indexPage?: boolean;
  /** 文章页自己渲染标题，避免与自动标题区重复 */
  hidePageHeader?: boolean;
  pageCover?: ImageMetadata | string;
  /** SEO：页面描述（og:description / twitter:description） */
  description?: string;
  /** SEO：覆盖 og:title（默认用 pageTitle；传空字符串回退到站点名） */
  seoTitle?: string;
  /** SEO：OG 类型，文章页传 "article" */
  seoType?: "website" | "article";
  /** SEO：文章发布/更新时间与标签 */
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  /** 标题区的栏目名（不传时按路径推断） */
  eyebrow?: string;
}

const {
  pageTitle = "",
  indexPage = false,
  hidePageHeader = false,
  pageCover,
  description,
  seoTitle,
  seoType = "website",
  publishedTime,
  modifiedTime,
  tags,
  eyebrow,
} = Astro.props;

// 旧布局参数（toc/relatedPosts/currentSlug/navigation/postMeta）仍然允许传入，
// 但新版外壳不再使用侧栏，保留签名是为了让既有页面无需一次性改完。
const navLinks = themeConfig.nav;
const siteName = themeConfig.siteName;
const sidebarConfig = themeConfig.sidebar || {};
const footerConfig = themeConfig.footer || {};
const visibilityTitleConfig = themeConfig.visibilityTitle || {};

const sectionLabels: Record<string, string> = {
  "/about/": "About",
  "/archives/": "Archive",
  "/categories/": "Topics",
  "/tags/": "Tags",
  "/friends/": "Friends",
  "/moments/": "Moments",
  "/guestbook/": "Guestbook",
  "/stars/": "Stars",
  "/summer/": "Summer",
  "/statistics/": "Statistics",
  "/random/": "Random",
  "/search/": "Search",
};

const pathname = Astro.url.pathname;
const inferredEyebrow = sectionLabels[pathname] ?? (pathname.startsWith("/archives/") ? "Archive" : "");
const pageEyebrow = eyebrow ?? inferredEyebrow;
const showPageHeader = !indexPage && !hidePageHeader && Boolean(pageTitle);

// 文档标题：首页用站点名 + 副标题，内页追加站点名
const brandTitle = themeConfig.brand?.title ?? siteName ?? "Echo";
const brandSubtitle = themeConfig.brand?.subtitle ?? "";
const siteLabel = brandSubtitle ? `${brandTitle} · ${brandSubtitle}` : brandTitle;
const documentTitle = pageTitle
  ? pageTitle.includes(brandTitle)
    ? pageTitle
    : `${pageTitle} · ${siteLabel}`
  : siteLabel;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- 首屏渲染前同步主题，避免暗色用户闪白（FOUC） -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("shokax-color-scheme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia &&
                  window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* 存储不可用时保持默认亮色 */
        }
      })();
    </script>

    <SEO
      title={seoTitle !== undefined ? seoTitle : pageTitle || undefined}
      description={description}
      image={pageCover}
      type={seoType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />

    <Analytics />

    <slot name="head" />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <title>{documentTitle}</title>
  </head>
  <body data-visibility-title-config={JSON.stringify(visibilityTitleConfig)}>
    <a class="skip-link" href="#main">跳转到主要内容</a>

    <NavBar
      client:load
      name={siteName}
      navLinks={navLinks}
      clickToggleCallback={() => void 0}
    />
    <SearchPage client:idle selector="#search" />
    <Icons />

    <div id="container">
      <main id="main" class="site-main">
        {showPageHeader && (
          <div class="wrap">
            <PageHeader
              title={pageTitle}
              eyebrow={pageEyebrow}
              description={description}
            />
          </div>
        )}
        <slot />
      </main>

      <Footer
        config={footerConfig}
        {siteName}
        author={sidebarConfig.author || ""}
      />
    </div>

    <script>
      import "@/toolkit/initMdxComponents";
    </script>

    <script>
      type VisibilityTitleScriptConfig = {
        enable: boolean;
        leaveTitle: string;
        returnTitle: string;
        restoreDelay: number;
      };

      const parseVisibilityTitleConfig = () => {
        const raw = document.body.dataset.visibilityTitleConfig;
        if (!raw) {
          return {} as Partial<VisibilityTitleScriptConfig>;
        }

        try {
          const parsed = JSON.parse(raw) as unknown;
          if (typeof parsed === "object" && parsed !== null) {
            return parsed as Partial<VisibilityTitleScriptConfig>;
          }
        } catch {
          // ignore malformed JSON and fallback to defaults
        }

        return {} as Partial<VisibilityTitleScriptConfig>;
      };

      const visibilityTitleConfigData = parseVisibilityTitleConfig();
      const config = {
        enable: visibilityTitleConfigData.enable ?? true,
        leaveTitle:
          visibilityTitleConfigData.leaveTitle ?? "(╥﹏╥) 不要走嘛...",
        returnTitle:
          visibilityTitleConfigData.returnTitle ?? "(๑•̀ㅂ•́)و✧ 欢迎回来！",
        restoreDelay: visibilityTitleConfigData.restoreDelay ?? 3000,
      };

      if (config.enable) {
        let originalTitle = document.title;
        let restoreTimer: number | undefined;

        const clearRestoreTimer = () => {
          if (restoreTimer !== undefined) {
            window.clearTimeout(restoreTimer);
            restoreTimer = undefined;
          }
        };

        const onVisibilityChange = () => {
          clearRestoreTimer();

          if (document.hidden) {
            originalTitle = document.title;
            document.title = config.leaveTitle;
            const delay =
              Number.isFinite(config.restoreDelay) && config.restoreDelay >= 0
                ? config.restoreDelay
                : 3000;

            restoreTimer = window.setTimeout(() => {
              document.title = originalTitle;
            }, delay);
            return;
          }

          document.title = config.returnTitle;
          const delay =
            Number.isFinite(config.restoreDelay) && config.restoreDelay >= 0
              ? config.restoreDelay
              : 3000;

          restoreTimer = window.setTimeout(() => {
            document.title = originalTitle;
          }, delay);
        };

        document.addEventListener("visibilitychange", onVisibilityChange);
      }
    </script>

    <!-- 文章代码复制与图片灯箱依赖这两个自定义元素，必须保留 -->
    <div class="hidden">
      <CodeBlock client:idle />
      <ImageZoom client:idle />
    </div>
  </body>
</html>

<style>
  .site-main {
    display: block;
    width: 100%;
    padding-bottom: var(--rhythm-section, 4.5rem);
  }

  #container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
