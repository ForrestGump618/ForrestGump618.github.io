---
/**
 * 站点外壳：主题引导、SEO、导航、页面标题区、页脚与全局脚本。
 *
 * 设计取向：编辑式极简 + 克制的氛围动效。页面自身负责正文容器与内容排版；
 * 悬浮工具栏提供返回顶部 / 阅读进度 / 烟花开关等全局小交互。
 */
import Analytics from "@/components/Analytics.astro";
import CodeBlock from "@/components/CodeBlock.svelte";
import FloatingToolbar from "@/components/FloatingToolbar.svelte";
import Footer from "@/components/footer/Footer.astro";
import ImageZoom from "@/components/ImageZoom.svelte";
import NavBar from "@/components/navbar/NavBar.svelte";
import SEO from "@/components/SEO.astro";
import PageHeader from "@/components/shell/PageHeader.astro";
import type { RelatedPost, TocItem, QuickNavigation } from "@/components/sidebar/SidebarTypes";
import { currentLocale } from "@/i18n";
import themeConfig from "@/theme.config.ts";

import "@vtbag/element-crossing?url";
import "@/styles/view-transition.css";
import "@/styles/palette.css";
import "@/styles/tokens.css";
import "@/styles/style.css";
import "@/styles/navigation.css";
import "@/styles/mdx-components.css";
import "@/styles/icons.css";

import type { ImageMetadata } from "astro";

interface PostMeta {
  date: Date;
  wordCount: number;
  readTime: number;
}

interface Props {
  toc?: TocItem[];
  relatedPosts?: RelatedPost[];
  currentSlug?: string;
  navigation?: QuickNavigation;
  pageTitle?: string;
  postMeta?: PostMeta;
  indexPage?: boolean;
  /** 文章页自己渲染标题，避免与自动标题区重复 */
  hidePageHeader?: boolean;
  pageCover?: ImageMetadata | string;
  /** SEO：页面描述（og:description / twitter:description） */
  description?: string;
  /** SEO：覆盖 og:title（默认用 pageTitle；传空字符串回退到站点名） */
  seoTitle?: string;
  /** SEO：OG 类型，文章页传 "article" */
  seoType?: "website" | "article";
  /** SEO：文章发布/更新时间与标签 */
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  /** 标题区的栏目名（不传时按路径推断） */
  eyebrow?: string;
}

const {
  pageTitle = "",
  indexPage = false,
  hidePageHeader = false,
  pageCover,
  description,
  seoTitle,
  seoType = "website",
  publishedTime,
  modifiedTime,
  tags,
  eyebrow,
} = Astro.props;

// 旧布局参数（toc/relatedPosts/currentSlug/navigation/postMeta）仍然允许传入，
// 但新版外壳不再使用侧栏，保留签名是为了让既有页面无需一次性改完。
const navLinks = themeConfig.nav;
const siteName = themeConfig.siteName;
const sidebarConfig = themeConfig.sidebar || {};
const footerConfig = themeConfig.footer || {};
const visibilityTitleConfig = themeConfig.visibilityTitle || {};

const showPageHeader = !indexPage && !hidePageHeader && Boolean(pageTitle);

// 文档标题：首页用站点名 + 副标题，内页追加站点名
const brandTitle = themeConfig.brand?.title ?? siteName ?? "Echo";
const brandSubtitle = themeConfig.brand?.subtitle ?? "";
const siteLabel = brandSubtitle ? `${brandTitle} · ${brandSubtitle}` : brandTitle;
const documentTitle = pageTitle
  ? pageTitle.includes(brandTitle)
    ? pageTitle
    : `${pageTitle} · ${siteLabel}`
  : siteLabel;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/poetry-lcp.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/fonts/poetry-core.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <script is:inline>
      // 入场动效等字体落定再播放：swap 的整页重排不与动效抢帧。
      // 解析完成后再等字体（此时字体请求已发起）：500ms 竞争上限 + 1.2s 绝对兜底；
      // 入场只位移不隐藏，首屏文本首绘即可见（LCP 不受门控影响）；
      // js-motion 保证无 JS 时内容不被隐藏。
      document.documentElement.classList.add("js-motion");
      const settleFonts = () => document.documentElement.classList.add("fonts-ready");
      const parsed =
        document.readyState === "loading"
          ? new Promise((r) => document.addEventListener("DOMContentLoaded", r, { once: true }))
          : Promise.resolve();
      parsed
        .then(() => Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 500))]))
        .then(settleFonts);
      setTimeout(settleFonts, 1200);
    </script>
    <meta name="generator" content={Astro.generator} />

    <!-- 首屏渲染前同步主题，避免暗色用户闪白（FOUC） -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("shokax-color-scheme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia &&
                  window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* 存储不可用时保持默认亮色 */
        }
      })();
    </script>

    <SEO
      title={seoTitle !== undefined ? seoTitle : pageTitle || undefined}
      description={description}
      image={pageCover}
      type={seoType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />

    <Analytics />

    <slot name="head" />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <title>{documentTitle}</title>
  </head>
  <body data-visibility-title-config={JSON.stringify(visibilityTitleConfig)}>
    <a class="skip-link" href="#main">跳转到主要内容</a>

    <NavBar client:idle name={siteName} navLinks={navLinks} path={Astro.url.pathname} />

    <script is:inline>
      // 头部开关在解析期即可用：水合前由本脚本接管主题/菜单/搜索，
      // 点击不再被 disabled 吞掉；NavBar 水合后写上 data-hydrated 交还控制权。
      (function () {
        var header = document.querySelector(".site-header");
        if (!header) return;
        var drawer = document.getElementById("mobile-drawer");
        var menuBtn = header.querySelector(".tool-btn--menu");
        var themeBtn = header.querySelector("[data-theme-toggle]");
        var searchBtn = document.getElementById("search");
        var dialog = document.getElementById("site-search");
        var hydrated = function () {
          return header.dataset.hydrated === "true";
        };
        [menuBtn, themeBtn, searchBtn].forEach(function (btn) {
          if (btn) btn.disabled = false;
        });
        if (themeBtn) {
          themeBtn.addEventListener("click", function () {
            if (hydrated()) return;
            var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
            document.documentElement.dataset.theme = next;
            themeBtn.setAttribute(
              "aria-label",
              next === "dark" ? "切换到浅色模式" : "切换到深色模式",
            );
            // 存储键与 toolkit/ui/theme.ts 保持一致，水合后 initTheme 才能读到同一意图
            try {
              localStorage.setItem("shokax-color-scheme", next);
            } catch (e) {
              /* 存储不可用时仅切换本次会话 */
            }
          });
        }
        if (menuBtn && drawer) {
          var setMenu = function (open) {
            header.classList.toggle("is-open", open);
            drawer.inert = !open;
            menuBtn.setAttribute("aria-expanded", String(open));
            menuBtn.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
          };
          menuBtn.addEventListener("click", function () {
            if (hydrated()) return;
            setMenu(!header.classList.contains("is-open"));
          });
          // 与 island 一致：点击抽屉外或按 Escape 关闭，避免水合前后行为不一致
          document.addEventListener("pointerdown", function (event) {
            if (hydrated() || !header.classList.contains("is-open")) return;
            var target = event.target;
            if (target instanceof Node && !drawer.contains(target) && !menuBtn.contains(target)) {
              setMenu(false);
            }
          });
          document.addEventListener("keydown", function (event) {
            if (hydrated() || event.key !== "Escape") return;
            if (header.classList.contains("is-open")) {
              setMenu(false);
              menuBtn.focus({ preventScroll: true });
            }
          });
        }
        if (searchBtn && dialog) {
          var openPanel = function () {
            if (hydrated() || dialog.open) return;
            dialog.showModal();
            var close = dialog.querySelector(".search-panel__close");
            if (close) close.focus({ preventScroll: true });
          };
          searchBtn.addEventListener("click", openPanel);
          // 水合前关闭按钮也得可用：boot 能开面板，就必须能关面板
          var closeBtn = dialog.querySelector(".search-panel__close");
          if (closeBtn) {
            closeBtn.addEventListener("click", function () {
              if (hydrated() || !dialog.open) return;
              dialog.close();
              searchBtn.focus({ preventScroll: true });
            });
          }
          // 与 SearchPage 一致：Ctrl/⌘+K 开面板，但输入框聚焦时不抢占
          document.addEventListener("keydown", function (event) {
            if (hydrated()) return;
            if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== "k") return;
            var active = document.activeElement;
            if (
              active instanceof HTMLElement &&
              (active.tagName === "INPUT" ||
                active.tagName === "TEXTAREA" ||
                active.tagName === "SELECT" ||
                active.isContentEditable)
            ) {
              return;
            }
            event.preventDefault();
            openPanel();
          });
        }
      })();
    </script>

    <div id="container">
      <main id="main" class="site-main">
        {showPageHeader && (
          <div class="wrap">
            <PageHeader
              title={pageTitle}
              eyebrow={eyebrow}
              description={description}
            />
          </div>
        )}
        <slot />
      </main>

      <Footer
        config={footerConfig}
        {siteName}
        author={sidebarConfig.author || ""}
      />
    </div>

    <FloatingToolbar client:idle nyxPlayer={themeConfig.nyxPlayer} />

    <script>
      import "@/toolkit/initMdxComponents";
      import { initFireworks } from "@/toolkit/ui/fireworks";
      import { initPageTransition } from "@/toolkit/ui/pageTransition";
      import { initPressRing } from "@/toolkit/ui/pressRing";
      import { initScrollReveal } from "@/toolkit/ui/scrollReveal";

      // 烟花开关先读本机偏好；store 依赖 Svelte 运行时，
      // 留到 load 后再订阅，避免首屏为一个小开关拉入整包运行时。
      let fireworksOn = true;
      try {
        fireworksOn = window.localStorage.getItem("echo-fireworks") !== "off";
      } catch {
        /* 存储不可用时默认开启 */
      }
      const syncFireworksStore = () => {
        void import("@/stores/fireworksStore").then(({ fireworksEnabled }) => {
          fireworksEnabled.subscribe((value) => {
            fireworksOn = value;
          });
        });
      };
      if (document.readyState === "complete") {
        syncFireworksStore();
      } else {
        window.addEventListener("load", syncFireworksStore, { once: true });
      }

      initScrollReveal(document, window);
      initPageTransition(document, window);
      initPressRing(document, window);
      initFireworks(document, window, {
        isEnabled: () => fireworksOn,
      });
    </script>

    <script>
      type VisibilityTitleScriptConfig = {
        enable: boolean;
        leaveTitle: string;
        returnTitle: string;
        restoreDelay: number;
      };

      const parseVisibilityTitleConfig = () => {
        const raw = document.body.dataset.visibilityTitleConfig;
        if (!raw) {
          return {} as Partial<VisibilityTitleScriptConfig>;
        }

        try {
          const parsed = JSON.parse(raw) as unknown;
          if (typeof parsed === "object" && parsed !== null) {
            return parsed as Partial<VisibilityTitleScriptConfig>;
          }
        } catch {
          // ignore malformed JSON and fallback to defaults
        }

        return {} as Partial<VisibilityTitleScriptConfig>;
      };

      const visibilityTitleConfigData = parseVisibilityTitleConfig();
      const config = {
        enable: visibilityTitleConfigData.enable ?? true,
        leaveTitle:
          visibilityTitleConfigData.leaveTitle ?? "(╥﹏╥) 不要走嘛...",
        returnTitle:
          visibilityTitleConfigData.returnTitle ?? "(๑•̀ㅂ•́)و✧ 欢迎回来！",
        restoreDelay: visibilityTitleConfigData.restoreDelay ?? 3000,
      };

      if (config.enable) {
        let originalTitle = document.title;
        let restoreTimer: number | undefined;

        const clearRestoreTimer = () => {
          if (restoreTimer !== undefined) {
            window.clearTimeout(restoreTimer);
            restoreTimer = undefined;
          }
        };

        const onVisibilityChange = () => {
          clearRestoreTimer();

          if (document.hidden) {
            originalTitle = document.title;
            document.title = config.leaveTitle;
            const delay =
              Number.isFinite(config.restoreDelay) && config.restoreDelay >= 0
                ? config.restoreDelay
                : 3000;

            restoreTimer = window.setTimeout(() => {
              document.title = originalTitle;
            }, delay);
            return;
          }

          document.title = config.returnTitle;
          const delay =
            Number.isFinite(config.restoreDelay) && config.restoreDelay >= 0
              ? config.restoreDelay
              : 3000;

          restoreTimer = window.setTimeout(() => {
            document.title = originalTitle;
          }, delay);
        };

        document.addEventListener("visibilitychange", onVisibilityChange);
      }
    </script>

    <!-- 文章代码复制与图片灯箱依赖这两个自定义元素，必须保留 -->
    <div class="hidden">
      <CodeBlock client:idle />
      <ImageZoom client:idle />
    </div>
  </body>
</html>

<style>
  .site-main {
    display: block;
    width: 100%;
    padding-bottom: var(--rhythm-section, 4.5rem);
  }

  #container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>
